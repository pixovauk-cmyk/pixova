{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pixova.uk" }],
      "destination": "https://www.pixova.uk/:path*",
      "statusCode": 301
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html",
      "statusCode": 302
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy/",
      "statusCode": 301
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy/",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "/about/",
      "statusCode": 301
    },
    {
      "source": "/pricing",
      "destination": "/pricing/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
