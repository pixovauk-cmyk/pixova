---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Pixova"
  description="This page doesn't exist. Head back to the Pixova homepage to find what you're looking for."
  canonicalUrl="https://pixova.uk/404/"
>
  <section class="py-32 bg-offwhite min-h-[60vh] flex items-center">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
      <div class="font-heading font-semibold mb-6 select-none" style="font-size:96px; line-height:1; color:#E8F5F1;">404</div>
      <h1 class="font-heading font-semibold text-3xl mb-4" style="color:#1C3557;">
        This page doesn't exist.
      </h1>
      <p class="text-base mb-8" style="color:#1A2E3D;">
        It might have moved, or you may have followed a broken link.
        Either way, let's get you somewhere useful.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3.5 rounded-lg min-h-[48px]"
          style="background-color:#2ECC9A; color:#fff;"
        >
          Back to home
        </a>
        <a
          href="/about#contact"
          class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3.5 rounded-lg border-2 min-h-[48px]"
          style="border-color:#1C3557; color:#1C3557;"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</Layout>
