---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Pixova"
  description="This page doesn't exist. Head back to the Pixova homepage."
  canonicalUrl="https://www.pixova.uk/404/"
  noindex={true}
>
  <section class="section min-h-[60vh] flex items-center">
    <div class="wrap-narrow text-center">
      <p class="font-heading font-bold text-[7rem] leading-none text-mint">404</p>
      <h1 class="h2 mt-4">This page doesn't exist.</h1>
      <p class="lead mt-4">It may have moved, or the link was wrong. Let's get you somewhere useful.</p>
      <div class="flex flex-wrap gap-3 justify-center mt-8">
        <a href="/" class="btn btn-dark">Back to home</a>
        <a href="/contact/" class="btn btn-outline">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
