---
import Layout from '../layouts/Layout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Contact Pixova | Get a Fixed Quote for Your Website or Software"
  description="Tell Pixova what you need: a website, local SEO or a custom tool. Fixed price within one working day. Email hello@pixova.uk or WhatsApp +44 7786 366109."
  canonicalUrl="https://www.pixova.uk/contact/"
  breadcrumbs={[{ name: 'Home', url: 'https://www.pixova.uk/' }, { name: 'Contact', url: 'https://www.pixova.uk/contact/' }]}
>
  <section class="px-5 sm:px-6 pt-[clamp(32px,5vw,72px)] pb-[clamp(80px,9vw,128px)]">
    <div class="max-w-[1240px] mx-auto flex flex-wrap gap-12 items-start">
      <div class="flex-[1_1_380px] min-w-0 flex flex-col gap-7">
        <Eyebrow icon="chat" white>Get in touch</Eyebrow>
        <h1 class="font-medium text-[clamp(48px,5.4vw,78px)] leading-[0.98] tracking-[-0.055em]">Let's Get Your Phone <span class="grad-text">Ringing.</span></h1>
        <p class="text-base leading-relaxed text-body max-w-[440px]">Tell me a bit about your business and what you need. I'll reply within one working day with a fixed price, or a couple of quick questions. Usually much faster.</p>

        <div class="flex items-center gap-3.5 py-2.5 pl-2.5 pr-5 rounded-full bg-white w-fit max-w-full shadow-[0_18px_40px_-20px_rgba(11,23,38,0.3)]">
          <img src="/images/anil.webp" alt="Anil Jaishi" width="48" height="48" class="w-12 h-12 rounded-full object-cover object-top" />
          <span class="flex flex-col"><span class="font-semibold text-[15px]">You'll hear from Anil</span><span class="text-[13px] text-body">Founder · usually replies within minutes</span></span>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <a href={SITE.whatsapp} target="_blank" rel="noopener" class="flex flex-col gap-[18px] p-[22px] rounded-[24px] text-white card-hover" style="background-color:#07111F;background-image:radial-gradient(90% 90% at 100% 0%, rgba(34,199,214,0.5) 0%, rgba(34,199,214,0) 60%), radial-gradient(80% 80% at 0% 100%, rgba(43,217,143,0.45) 0%, rgba(43,217,143,0) 60%)">
            <span class="w-10 h-10 rounded-full bg-teal grid place-items-center text-navy"><Icon name="whatsapp" size={18} /></span>
            <span class="flex flex-col gap-0.5"><span class="font-semibold">WhatsApp</span><span class="text-[13px] text-[#A9B6C4]">{SITE.phone} · quickest</span></span>
          </a>
          <a href={`mailto:${SITE.email}`} class="flex flex-col gap-[18px] p-[22px] rounded-[24px] bg-white text-navy card-hover">
            <span class="w-10 h-10 rounded-full bg-mint grid place-items-center text-teal-dark"><Icon name="mail" size={18} /></span>
            <span class="flex flex-col gap-0.5"><span class="font-semibold">Email</span><span class="text-[13px] text-body">{SITE.email}</span></span>
          </a>
          <a href={SITE.calendly} target="_blank" rel="noopener" class="sm:col-span-2 flex items-center gap-4 p-[22px] rounded-[24px] bg-white text-navy card-hover">
            <span class="w-10 h-10 rounded-full bg-mint grid place-items-center text-teal-dark shrink-0"><Icon name="calendar" size={18} /></span>
            <span class="flex flex-col gap-0.5"><span class="font-semibold">Book a 30-minute call</span><span class="text-[13px] text-body">Pick a slot that suits you. No sales pitch.</span></span>
          </a>
        </div>
        <p class="text-sm text-muted">Based in Birmingham. Working with small businesses across the UK.</p>
      </div>

      <div class="flex-[999_1_560px] min-w-0">
        <EnquiryForm id="contact-enquiry" showBudget />
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pre-fill from links like /contact/?design=Hartley%20Plumbing or ?type=custom-software
  const params = new URLSearchParams(location.search);
  const design = params.get('design');
  const type = params.get('type');
  const msg = document.getElementById('contact-enquiry-message') as HTMLTextAreaElement | null;
  if (design && msg) msg.value = `I like the "${design}" design style.\n\nMy business: `;
  // Set state directly: the form's own script may not have attached its listeners yet
  const want = type ?? (design ? 'website' : null);
  const chip = want ? document.querySelector<HTMLButtonElement>(`#contact-enquiry .pick[data-value="${CSS.escape(want)}"]`) : null;
  const typeInput = document.getElementById('contact-enquiry-type') as HTMLInputElement | null;
  if (chip && typeInput) { chip.setAttribute('aria-pressed', 'true'); typeInput.value = want!; }
</script>
