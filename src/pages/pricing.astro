---
import Layout from '../layouts/Layout.astro';

const pricingSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.pixova.uk/pricing/",
      "name": "Local SEO Packages & Web Design Prices | Pixova Birmingham",
      "url": "https://www.pixova.uk/pricing/",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.pixova.uk/" },
          { "@type": "ListItem", "position": 2, "name": "Pricing", "item": "https://www.pixova.uk/pricing/" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "When do I pay the setup fee?",
          "acceptedAnswer": { "@type": "Answer", "text": "Only when your site goes live. I build it first, you see it, and only then do you pay the setup fee and I switch it on." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Monthly, 6 months, and Rolling monthly plans?",
          "acceptedAnswer": { "@type": "Answer", "text": "Monthly (3-month minimum) is the most popular with a lower rate than rolling and a short commitment. Six months saves £10–20 per month if you are ready to commit longer. Rolling is cancel-anytime with 30 days notice but costs slightly more per month. The setup fee is the same across all three options." }
        },
        {
          "@type": "Question",
          "name": "What happens after the minimum term?",
          "acceptedAnswer": { "@type": "Answer", "text": "After the minimum term it rolls month to month automatically. Cancel anytime with 30 days notice." }
        },
        {
          "@type": "Question",
          "name": "Do Pixova web design and SEO prices include VAT?",
          "acceptedAnswer": { "@type": "Answer", "text": "Pixova is not VAT registered, so no VAT is added to any prices shown. What you see is what you pay." }
        },
        {
          "@type": "Question",
          "name": "Can I add AI services to my existing website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. The AI and automation services work on any website, not just ones Pixova has built." }
        }
      ]
    },
    {
      "@type": "OfferCatalog",
      "name": "Local SEO and Web Design Packages",
      "provider": { "@type": "LocalBusiness", "name": "Pixova", "url": "https://www.pixova.uk" },
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Get Online — Starter Web Design Plan",
          "description": "5-page website, hosting, SSL, Google Analytics, 2 content updates per month. Setup fee £199 paid on go-live.",
          "price": "69",
          "priceCurrency": "GBP",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "69", "priceCurrency": "GBP", "unitText": "MONTH" },
          "url": "https://www.pixova.uk/pricing/"
        },
        {
          "@type": "Offer",
          "name": "Get Found — Growth Local SEO Plan",
          "description": "8-page website, local SEO, 1 blog post per month, Google Business Profile, 3 content updates, monthly ranking report. Setup fee £359 paid on go-live.",
          "price": "119",
          "priceCurrency": "GBP",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "119", "priceCurrency": "GBP", "unitText": "MONTH" },
          "url": "https://www.pixova.uk/pricing/"
        },
        {
          "@type": "Offer",
          "name": "Get Leads — Pro Local SEO Plan",
          "description": "12-page website, full local SEO management, 2 blog posts per month, Google Business Profile managed weekly, competitor monitoring, WhatsApp access. Setup fee £599 paid on go-live.",
          "price": "169",
          "priceCurrency": "GBP",
          "priceSpecification": { "@type": "UnitPriceSpecification", "price": "169", "priceCurrency": "GBP", "unitText": "MONTH" },
          "url": "https://www.pixova.uk/pricing/"
        }
      ]
    }
  ]
};
---

<Layout
  title="Local SEO Packages & Web Design Prices | Pixova Birmingham"
  description="Affordable local SEO packages and web design prices for UK small businesses. From £59/month on 6-month term. Setup fee paid on go-live, nothing before that. Birmingham-based."
  canonicalUrl="https://www.pixova.uk/pricing/"
  schema={pricingSchema}
>

  <!-- HERO -->
  <section class="relative pt-20 pb-16 overflow-hidden" style="background:#0D2240; min-height:340px;">
    <div class="absolute inset-0" style="background-image:url('/images/pricing-hero.webp'); background-size:cover; background-position:center; opacity:0.45;"></div>
    <div class="absolute inset-0" style="background:linear-gradient(135deg, rgba(13,34,64,0.88) 0%, rgba(28,53,87,0.6) 50%, rgba(13,34,64,0.88) 100%);"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
      <span class="text-xs font-semibold tracking-widest uppercase" style="color:#2ECC9A;">PRICING</span>
      <h1 class="font-heading font-semibold text-4xl sm:text-5xl mt-3 mb-5 leading-tight" style="color:#fff; max-width:36rem;">
        Local SEO Packages &amp; Web Design Prices for Small Businesses.
      </h1>
      <p class="text-base max-w-xl leading-relaxed" style="color:rgba(255,255,255,0.68);">
        I build your site first. You only pay the setup fee when it goes live. Then one flat monthly fee covers everything — hosting, updates, SEO, and support.
      </p>
      <div class="flex flex-wrap items-center gap-5 mt-8">
        {[
          'Nothing to pay until live',
          'Live in 7 working days',
          'You own the site',
          'Cancel after minimum term',
        ].map(item => (
          <span class="flex items-center gap-1.5 text-xs font-medium" style="color:rgba(255,255,255,0.7);">
            <span class="w-4 h-4 rounded-full flex items-center justify-center flex-shrink-0" style="background:rgba(46,204,154,0.2); color:#2ECC9A; font-size:9px;">✓</span>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase" style="color:#2ECC9A;">WEBSITE PLANS</span>
        <h2 class="font-heading font-semibold text-3xl mt-2 mb-3" style="color:#1C3557;">
          Pick a plan. Pick your term.
        </h2>
        <p class="text-sm leading-relaxed max-w-xl" style="color:#4a6070;">
          Same setup fee regardless of term. Monthly gives flexibility. Six months saves you money each month. Rolling is fully cancel-anytime.
        </p>
      </div>

      <!-- June offer -->
      <div class="rounded-2xl overflow-hidden mb-10" style="background:#0D2240;">
        <div class="relative px-5 py-4 sm:px-6 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
          <div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(135deg, rgba(46,204,154,0.04) 0px, rgba(46,204,154,0.04) 1px, transparent 1px, transparent 12px);"></div>
          <div class="relative flex items-center gap-3 flex-1">
            <span class="flex-shrink-0 text-xs font-black tracking-widest uppercase px-2.5 py-1.5 rounded-lg" style="background:#DC2626; color:#fff; letter-spacing:0.08em;">June only</span>
            <div>
              <p class="text-sm font-semibold leading-snug" style="color:#fff;">£50 off setup fee on the Monthly plan. <span style="color:#2ECC9A;">3 spots left.</span></p>
              <p class="text-xs mt-0.5" style="color:rgba(255,255,255,0.45);">Closes 30 June. Just mention it when you get in touch.</p>
            </div>
          </div>
          <a href="/about/#contact" class="relative flex-shrink-0 text-xs font-bold px-4 py-2.5 rounded-xl whitespace-nowrap transition-opacity hover:opacity-90" style="background:#2ECC9A; color:#0D2240;">
            Claim offer →
          </a>
        </div>
      </div>

      <!-- Term toggle -->
      <div class="flex items-center mb-10">
        <div class="inline-flex items-center p-1 rounded-full gap-0.5" style="background:#f0f4f7;">
          <button class="term-btn text-xs font-bold px-5 py-2.5 rounded-full transition-all relative" data-term="monthly" style="background:#2ECC9A; color:#0D2240;">
            Monthly
            <span class="absolute -top-2.5 -right-1 text-[8px] font-black px-1.5 py-0.5 rounded-full leading-none whitespace-nowrap" style="background:#0D2240; color:#2ECC9A;">★ Popular</span>
          </button>
          <button class="term-btn text-xs font-bold px-5 py-2.5 rounded-full transition-all" data-term="six" style="color:#4a6070;">
            6 months
          </button>
          <button class="term-btn text-xs font-bold px-5 py-2.5 rounded-full transition-all" data-term="rolling" style="color:#4a6070;">
            Rolling
          </button>
        </div>
        <span class="ml-4 text-xs hidden sm:block" style="color:#8a9ab0;">← toggle to compare</span>
      </div>

      <!-- Plan cards -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Starter -->
        <div class="rounded-2xl border bg-white flex flex-col plan-card" style="border-color:#e8ecef; box-shadow:0 2px 20px rgba(13,34,64,0.06);">
          <div class="p-6 pb-0">
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background:#f0f4f7; color:#8a9ab0;">STARTER</span>
            </div>
            <h3 class="font-heading font-bold text-xl mb-1" style="color:#1C3557;">Get Online</h3>
            <p class="text-xs mb-6" style="color:#8a9ab0;">Your first proper web presence.</p>

            <div class="mb-2">
              <div class="flex items-end gap-1.5">
                <span class="font-bold plan-monthly" data-monthly="£69" data-six="£59" data-rolling="£79" style="font-size:3rem; line-height:1; color:#1C3557; letter-spacing:-0.02em;">£69</span>
                <span class="text-sm font-medium pb-2" style="color:#8a9ab0;">/month</span>
              </div>
              <p class="text-xs mt-1.5 plan-term" data-monthly="3-month minimum" data-six="6-month minimum" data-rolling="Cancel anytime · 30 days notice" style="color:#8a9ab0;">3-month minimum</p>
            </div>

            <div class="mt-4 mb-1 inline-flex items-center gap-2 rounded-xl px-3 py-2" style="background:#f7f9fb;">
              <span class="text-xs" style="color:#8a9ab0;">Setup fee</span>
              <span class="font-bold text-sm" style="color:#1C3557;">£199</span>
              <span class="text-xs" style="color:#8a9ab0;">· paid on go-live</span>
            </div>

            <div class="mt-2 mb-5 h-5">
              <p class="text-xs font-semibold monthly-badge" style="color:#2ECC9A;">Nothing to pay until live</p>
              <p class="text-xs font-semibold six-badge hidden" style="color:#2ECC9A;">Save £10/mo vs monthly</p>
              <p class="text-xs font-semibold rolling-badge hidden" style="color:#8a9ab0;">Flexible, cancel anytime</p>
            </div>
          </div>

          <div class="px-6 pb-2">
            <div class="border-t pt-5" style="border-color:#f0f0f0;">
              <ul class="flex flex-col gap-2.5">
                {[
                  '5-page website built and launched',
                  'Mobile first, fast loading',
                  'Contact form + click-to-call',
                  'Google Analytics 4 connected',
                  'SSL + hosting included',
                  '2 content updates per month',
                  'Monthly traffic snapshot',
                  'Email support, 48hr response',
                ].map(item => (
                  <li class="flex items-start gap-2.5 text-xs" style="color:#4a6070;">
                    <span class="flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center mt-0.5" style="background:#E8F5F1; color:#2ECC9A; font-size:9px;">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-col gap-2 pt-4" style="border-top:1px solid #eef0f2;">
                {[
                  'Domain (~£10/yr, buy your own)',
                  'Google Business Profile',
                  'SEO or blog content',
                  'Design or layout changes',
                ].map(item => (
                  <div class="flex items-start gap-2.5 text-xs" style="color:#c8d0d8;">
                    <span class="flex-shrink-0 mt-0.5" style="color:#dde1e6; font-size:10px;">✕</span>
                    {item}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="p-6 pt-5 mt-auto">
            <a href="/about/#contact" class="block text-center text-sm font-semibold py-3.5 rounded-xl transition-all hover:opacity-90" style="background:#f0f4f7; color:#1C3557;">
              Get started →
            </a>
          </div>
        </div>

        <!-- Growth (featured) -->
        <div class="rounded-2xl flex flex-col relative plan-card" style="background:#0D2240; box-shadow:0 8px 40px rgba(13,34,64,0.25);">
          <div class="absolute -top-4 inset-x-0 flex justify-center">
            <span class="text-xs font-bold px-5 py-1.5 rounded-full" style="background:#2ECC9A; color:#0D2240;">Most popular</span>
          </div>

          <div class="p-6 pb-0 pt-8">
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background:rgba(46,204,154,0.12); color:rgba(46,204,154,0.7);">GROWTH</span>
            </div>
            <h3 class="font-heading font-bold text-xl mb-1" style="color:#fff;">Get Found</h3>
            <p class="text-xs mb-6" style="color:rgba(255,255,255,0.4);">SEO, content, and visibility built in.</p>

            <div class="mb-2">
              <div class="flex items-end gap-1.5">
                <span class="font-bold plan-monthly" data-monthly="£119" data-six="£99" data-rolling="£139" style="font-size:3rem; line-height:1; color:#fff; letter-spacing:-0.02em;">£119</span>
                <span class="text-sm font-medium pb-2" style="color:rgba(255,255,255,0.35);">/month</span>
              </div>
              <p class="text-xs mt-1.5 plan-term" data-monthly="3-month minimum" data-six="6-month minimum" data-rolling="Cancel anytime · 30 days notice" style="color:rgba(255,255,255,0.35);">3-month minimum</p>
            </div>

            <div class="mt-4 mb-1 inline-flex items-center gap-2 rounded-xl px-3 py-2" style="background:rgba(255,255,255,0.07);">
              <span class="text-xs" style="color:rgba(255,255,255,0.35);">Setup fee</span>
              <span class="font-bold text-sm" style="color:#2ECC9A;">£359</span>
              <span class="text-xs" style="color:rgba(255,255,255,0.35);">· paid on go-live</span>
            </div>

            <div class="mt-2 mb-5 h-5">
              <p class="text-xs font-semibold monthly-badge" style="color:#2ECC9A;">Nothing to pay until live</p>
              <p class="text-xs font-semibold six-badge hidden" style="color:#2ECC9A;">Save £20/mo vs monthly</p>
              <p class="text-xs font-semibold rolling-badge hidden" style="color:rgba(255,255,255,0.4);">Flexible, cancel anytime</p>
            </div>
          </div>

          <div class="px-6 pb-2">
            <div class="pt-5" style="border-top:1px solid rgba(255,255,255,0.08);">
              <ul class="flex flex-col gap-2.5">
                {[
                  'Everything in Get Online',
                  '8 pages — Blog, FAQ, Testimonials',
                  'Google Business Profile setup',
                  'Local SEO foundations',
                  '1 SEO blog post written monthly',
                  '3 content updates per month',
                  'Google Search Console monitored',
                  'Review request system',
                  'Monthly ranking report',
                  'Priority support, 24hr response',
                ].map(item => (
                  <li class="flex items-start gap-2.5 text-xs" style="color:rgba(255,255,255,0.65);">
                    <span class="flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center mt-0.5" style="background:rgba(46,204,154,0.18); color:#2ECC9A; font-size:9px;">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-col gap-2 pt-4" style="border-top:1px solid rgba(255,255,255,0.08);">
                {[
                  'GBP managed weekly',
                  'More than 3 updates/month',
                  'WhatsApp or same-day support',
                  'Competitor monitoring',
                ].map(item => (
                  <div class="flex items-start gap-2.5 text-xs" style="color:rgba(255,255,255,0.2);">
                    <span class="flex-shrink-0 mt-0.5" style="color:rgba(255,255,255,0.15); font-size:10px;">✕</span>
                    {item}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="p-6 pt-5 mt-auto">
            <a href="/about/#contact" class="block text-center text-sm font-semibold py-3.5 rounded-xl transition-all hover:opacity-90" style="background:#2ECC9A; color:#0D2240;">
              Get started →
            </a>
          </div>
        </div>

        <!-- Pro -->
        <div class="rounded-2xl border bg-white flex flex-col plan-card" style="border-color:#e8ecef; box-shadow:0 2px 20px rgba(13,34,64,0.06);">
          <div class="p-6 pb-0">
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-bold tracking-widest uppercase px-2.5 py-1 rounded-full" style="background:#f0f4f7; color:#8a9ab0;">PRO</span>
            </div>
            <h3 class="font-heading font-bold text-xl mb-1" style="color:#1C3557;">Get Leads</h3>
            <p class="text-xs mb-6" style="color:#8a9ab0;">Full-service, fully managed.</p>

            <div class="mb-2">
              <div class="flex items-end gap-1.5">
                <span class="font-bold plan-monthly" data-monthly="£169" data-six="£149" data-rolling="£189" style="font-size:3rem; line-height:1; color:#1C3557; letter-spacing:-0.02em;">£169</span>
                <span class="text-sm font-medium pb-2" style="color:#8a9ab0;">/month</span>
              </div>
              <p class="text-xs mt-1.5 plan-term" data-monthly="3-month minimum" data-six="6-month minimum" data-rolling="Cancel anytime · 30 days notice" style="color:#8a9ab0;">3-month minimum</p>
            </div>

            <div class="mt-4 mb-1 inline-flex items-center gap-2 rounded-xl px-3 py-2" style="background:#f7f9fb;">
              <span class="text-xs" style="color:#8a9ab0;">Setup fee</span>
              <span class="font-bold text-sm" style="color:#1C3557;">£599</span>
              <span class="text-xs" style="color:#8a9ab0;">· paid on go-live</span>
            </div>

            <div class="mt-2 mb-5 h-5">
              <p class="text-xs font-semibold monthly-badge" style="color:#2ECC9A;">Nothing to pay until live</p>
              <p class="text-xs font-semibold six-badge hidden" style="color:#2ECC9A;">Save £20/mo vs monthly</p>
              <p class="text-xs font-semibold rolling-badge hidden" style="color:#8a9ab0;">Flexible, cancel anytime</p>
            </div>
          </div>

          <div class="px-6 pb-2">
            <div class="border-t pt-5" style="border-color:#f0f0f0;">
              <ul class="flex flex-col gap-2.5">
                {[
                  'Everything in Get Found',
                  '12 pages — full service breakdown',
                  '2 SEO blog posts per month',
                  '6 content updates per month',
                  'GBP managed weekly + posts',
                  'Monthly competitor ranking report',
                  'Same-day emergency fixes',
                  'WhatsApp direct access',
                  'Quarterly 30-min strategy call',
                ].map(item => (
                  <li class="flex items-start gap-2.5 text-xs" style="color:#4a6070;">
                    <span class="flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center mt-0.5" style="background:#E8F5F1; color:#2ECC9A; font-size:9px;">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-col gap-2 pt-4" style="border-top:1px solid #eef0f2;">
                {[
                  'Paid ads management',
                  'Social media content creation',
                  'Video or photography',
                ].map(item => (
                  <div class="flex items-start gap-2.5 text-xs" style="color:#c8d0d8;">
                    <span class="flex-shrink-0 mt-0.5" style="color:#dde1e6; font-size:10px;">✕</span>
                    {item}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="p-6 pt-5 mt-auto">
            <a href="/about/#contact" class="block text-center text-sm font-semibold py-3.5 rounded-xl transition-all hover:opacity-90" style="background:#f0f4f7; color:#1C3557;">
              Get started →
            </a>
          </div>
        </div>

      </div>

      <p class="text-xs mt-8 text-center" style="color:#a0aab4;">
        All plans: live in 7 working days or your first month is free. You own the site outright. Cancel after the minimum term with 30 days notice.
      </p>

    </div>
  </section>

  <script>
    const termBtns = document.querySelectorAll('.term-btn');
    const monthlyEls = document.querySelectorAll('.plan-monthly');
    const termEls = document.querySelectorAll('.plan-term');
    const monthlyBadges = document.querySelectorAll('.monthly-badge');
    const sixBadges = document.querySelectorAll('.six-badge');
    const rollingBadges = document.querySelectorAll('.rolling-badge');

    function switchTerm(term) {
      monthlyEls.forEach(el => { el.textContent = el.dataset[term]; });
      termEls.forEach(el => { el.textContent = el.dataset[term]; });
      monthlyBadges.forEach(el => el.classList.toggle('hidden', term !== 'monthly'));
      sixBadges.forEach(el => el.classList.toggle('hidden', term !== 'six'));
      rollingBadges.forEach(el => el.classList.toggle('hidden', term !== 'rolling'));
      termBtns.forEach(btn => {
        const active = btn.dataset.term === term;
        btn.style.background = active ? '#2ECC9A' : 'transparent';
        btn.style.color = active ? '#0D2240' : '#4a6070';
      });
    }

    switchTerm('monthly');

    termBtns.forEach(btn => {
      btn.addEventListener('click', () => switchTerm(btn.dataset.term));
    });
  </script>

  <!-- ONE-OFF WORK -->
  <section class="py-20" style="background:#f7f9fb;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase" style="color:#2ECC9A;">ONE-OFF WORK</span>
        <h2 class="font-heading font-semibold text-3xl mt-2 mb-3" style="color:#1C3557;">
          Need something extra?
        </h2>
        <p class="text-sm leading-relaxed max-w-lg" style="color:#4a6070;">
          Extra pages, landing pages, major updates. On-plan clients get priority and a plan discount. The higher the plan, the lower the rate.
        </p>
      </div>

      <div class="rounded-2xl overflow-hidden" style="border:1px solid #e8ecef; box-shadow:0 2px 16px rgba(13,34,64,0.05);">
        <table class="w-full text-sm bg-white">
          <thead>
            <tr style="border-bottom:2px solid #f0f4f7;">
              <th class="text-left px-6 py-4 font-semibold text-sm" style="color:#1C3557; background:#fafbfc; width:45%;">Service</th>
              <th class="px-4 py-4 font-semibold text-xs text-center uppercase tracking-wider" style="color:#a0aab4; background:#fafbfc;">Starter</th>
              <th class="px-4 py-4 font-semibold text-xs text-center uppercase tracking-wider" style="color:#1C3557; background:#fafbfc;">Growth</th>
              <th class="px-4 py-4 font-semibold text-xs text-center uppercase tracking-wider" style="color:#2ECC9A; background:#fafbfc;">Pro</th>
            </tr>
          </thead>
