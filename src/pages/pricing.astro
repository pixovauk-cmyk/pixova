---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { PLANS, TERMS, SOFTWARE_FROM, OFFER, offerLive } from '../data/site';

const fromPrice = Math.min(...PLANS.map(p => p.six));
const planIcon: Record<string, string> = { starter: 'monitor', growth: 'search', pro: 'trend' };
const planTier: Record<string, string> = { starter: 'Starter', growth: 'Growth · Most popular', pro: 'Pro' };
const termNotes: Record<string, string> = {
  monthly: '3-month minimum, then month to month.',
  six: 'Commit for 6 months and pay the lowest price every month.',
  rolling: "No minimum. Cancel any time with 30 days' notice.",
};

const rows = [
  ['Pages', '5', '8 incl. blog', '12'],
  ['Changes per month', '2', '3', '6'],
  ['Hosting, SSL & backups', '✓', '✓', '✓'],
  ['Words written for you', '✓', '✓', '✓'],
  ['Google Business Profile', '—', 'Set up', 'Weekly posts'],
  ['Local SEO', '—', 'Foundations', '+ competitors'],
  ['SEO blog posts', '—', '1 / month', '2 / month'],
  ['Review requests', '—', '✓', '✓'],
  ['Ranking report', '—', 'Monthly', 'Monthly + competitors'],
  ['Support', 'Email 48hr', 'Priority 24hr', 'Same-day + WhatsApp'],
  ['Strategy call', '—', '—', 'Quarterly'],
];

const oneOff = [
  { service: 'Landing page', desc: 'New page, words and design included', starter: 149, growth: 119, pro: 89 },
  { service: 'Extra page', desc: 'Added to your existing site', starter: 89, growth: 69, pro: 49 },
  { service: 'Redesign', desc: 'New layout or look', starter: 199, growth: 159, pro: 99 },
  { service: 'Extra blog post', desc: 'On top of your monthly posts', starter: 59, growth: 45, pro: 35 },
  { service: 'New feature', desc: 'Booking form, gallery, popup', starter: 149, growth: 119, pro: 89 },
];

const addOns = [
  { name: 'Enquiry tracker (CRM)', text: 'Every enquiry saved in one place, with a reminder to follow up.', setup: 179, monthly: 35, items: ['Website leads saved automatically', 'Simple list: new, quoted, won', 'Alert on your phone', 'Follow-up reminder after 48 hours'] },
  { name: 'Follow-up emails', text: "People who enquire and don't book get helpful emails, so they remember you.", setup: 239, monthly: 59, items: ['5 emails, written in your voice', 'Sent after every enquiry', 'Monthly newsletter written and sent'] },
  { name: 'Both together', text: 'Tracker and follow-up emails connected, plus review requests after each job.', setup: 359, monthly: 79, best: true, items: ['Everything in both', 'Review request after each job', 'Monthly leads report', 'Save £59 a month'] },
];

const faq = [
  { q: 'What do I pay today?', a: 'Checkout takes your one-off setup fee and your first month. Monthly payments then carry on from the same date each month. Stripe emails you a receipt, and I email you to book the kick-off call.' },
  { q: "What's the difference between the three terms?", a: 'The 3-month plan is the most popular: a lower price with a short commitment. The 6-month plan is the cheapest per month. Rolling has no minimum, so you can cancel any time with 30 days notice, but it costs a little more. The setup fee is the same on all three.' },
  { q: 'How is custom software priced?', a: `Per project, from £${SOFTWARE_FROM} one-off. Tell me what you want the tool to do and I'll send a fixed price and a date within one working day. Nothing starts until you're happy with both.` },
  { q: 'What happens after the minimum term?', a: 'It carries on month to month. Cancel any time with 30 days notice.' },
  { q: 'Do I own the website?', a: "Your content, photos, logo and domain are yours. If you leave, I'll give you a copy of your content. The design and hosting are part of the monthly service." },
  { q: 'Can you work on my existing website?', a: "Yes. The SEO, custom software and add-ons work with most websites. Send me the link and I'll tell you what's worth doing and what isn't." },
  { q: 'Do prices include VAT?', a: "Pixova isn't VAT registered, so no VAT is added. The price you see is the price you pay." },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const showOffer = offerLive();
---

<Layout
  title="Website & Local SEO Prices for Small Businesses | Pixova"
  description={`Small business website plans from £${fromPrice}/month including hosting, changes and support. Local SEO plans and custom software from £${SOFTWARE_FROM}. No VAT added.`}
  canonicalUrl="https://www.pixova.uk/pricing/"
  breadcrumbs={[{ name: 'Home', url: 'https://www.pixova.uk/' }, { name: 'Pricing', url: 'https://www.pixova.uk/pricing/' }]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HEADER -->
  <section class="px-5 sm:px-6 pt-10 sm:pt-14 pb-10">
    <div class="max-w-[820px] mx-auto flex flex-col items-center gap-[22px] text-center">
      <span class="eyebrow has-icon"><span class="eyebrow-ico font-bold text-[13px]">£</span>Simple pricing</span>
      <h1 class="font-medium text-[clamp(48px,5.8vw,84px)] leading-[0.98] tracking-[-0.055em]">A Perfect Plan For You</h1>
      <p class="text-base leading-relaxed text-body max-w-[560px]">Build, hosting, changes and support, all handled for one monthly price. Need something bespoke? Custom software is quoted per project. Not VAT registered, so the price is the price.</p>

      {showOffer && (
        <div class="rounded-full px-4 py-2 flex flex-wrap items-center justify-center gap-3 text-sm" style={OFFER.festive ? 'background:#FDECEC' : 'background:var(--color-mint)'}>
          <span class="chip" style={OFFER.festive ? 'background:#D62828;color:#fff' : ''}>{OFFER.label}</span>
          <span class="font-medium text-navy">{OFFER.text}</span>
        </div>
      )}

      <div role="group" aria-label="Choose a term" class="flex flex-wrap justify-center gap-1 p-[5px] rounded-full bg-soft">
        {TERMS.map((t, i) => (
          <button type="button" class="term-btn min-h-11 px-5 rounded-full text-sm transition-colors" data-term={t.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {t.label}<span class="hidden sm:inline opacity-70"> · {t.note}</span>
          </button>
        ))}
      </div>
      <span id="term-note" class="text-[13px] text-muted">{termNotes.monthly}</span>
    </div>
  </section>

  <!-- PLAN CARDS -->
  <section class="px-5 sm:px-6 pt-4 pb-6">
    <div class="max-w-[1180px] mx-auto grid gap-4 lg:grid-cols-3 items-center">
      {PLANS.map(p => (
        <article class={`flex flex-col gap-5 ${p.featured ? 'rounded-[30px] px-[30px] py-[34px] shadow-[0_40px_80px_-30px_rgba(11,122,79,0.35)]' : 'rounded-[28px] p-[30px] border border-line bg-white'}`} style={p.featured ? 'border:2px solid transparent;background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg,#2BD98F,#22C7D6) border-box' : ''}>
          <div class="flex justify-between items-start">
            <span class="flex flex-col gap-0.5"><span class={`text-sm ${p.featured ? 'text-teal-dark font-semibold' : 'text-muted'}`}>{planTier[p.slug]}</span><span class="font-semibold text-xl">{p.name}</span></span>
            <span class={`w-10 h-10 rounded-full grid place-items-center ${p.featured ? 'bg-teal text-navy' : 'bg-navy text-teal'}`}><Icon name={planIcon[p.slug]} size={16} /></span>
          </div>
          <p class="text-sm text-body -mt-2">{p.tagline}</p>
          <div class="flex items-baseline gap-1.5"><span class={`plan-price font-medium tracking-[-0.05em] ${p.featured ? 'text-[64px]' : 'text-[56px]'}`} data-monthly={p.monthly} data-six={p.six} data-rolling={p.rolling}>£{p.monthly}</span><span class="text-sm text-muted">/month</span></div>
          <span class="text-[13px] text-body -mt-2.5">+ £{p.setup} one-off setup</span>
          <div class="flex flex-col gap-3 pt-[18px] border-t border-[#ECEFEC]">
            <span class="text-[13px] font-semibold">{p.slug === 'starter' ? 'What you get' : p.slug === 'growth' ? 'Everything in Get Online, plus' : 'Everything in Get Found, plus'}</span>
            <ul class="tick-list text-sm text-body">{p.features.filter(f => !f.startsWith('Everything in')).map(f => <li>{f}</li>)}</ul>
            <p class="text-xs text-muted">Best for: {p.bestFor}</p>
          </div>
          <a href={`/api/checkout/${p.slug}/?term=monthly`} data-plan={p.slug} rel="nofollow" class={`checkout-btn btn ${p.featured ? 'btn-grad has-chip' : 'btn-soft'}`}>
            {p.featured ? `Join ${p.name}` : `Choose ${p.name}`}
            {p.featured && <span class="chip-arrow"><Icon name="arrow" size={15} stroke={2.6} /></span>}
          </a>
          <a href="/contact/" class="text-center text-sm text-muted underline underline-offset-4 -mt-2">Rather talk first?</a>
        </article>
      ))}
    </div>
  </section>

  <!-- CUSTOM SOFTWARE TIER -->
  <section id="custom" class="px-5 sm:px-6 pt-4 pb-[clamp(80px,9vw,120px)] scroll-mt-24">
    <div class="max-w-[1180px] mx-auto rounded-[30px] overflow-hidden text-white grid lg:grid-cols-[1.3fr_1fr] shadow-[0_40px_80px_-40px_rgba(7,17,31,0.6)]" style="background-color:#07111F;background-image:radial-gradient(70% 90% at 100% 0%, rgba(34,199,214,0.45) 0%, rgba(34,199,214,0) 60%), radial-gradient(60% 80% at 0% 100%, rgba(43,217,143,0.35) 0%, rgba(43,217,143,0) 60%)">
      <div class="p-8 sm:p-10 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-teal text-navy grid place-items-center"><Icon name="code" size={17} /></span>
          <span class="flex flex-col"><span class="text-sm text-teal font-semibold">Bespoke · one-off</span><span class="font-semibold text-xl">Custom Software</span></span>
        </div>
        <p class="text-base leading-relaxed text-[#C8D3DD] max-w-[520px]">Big software is built for big companies. You end up paying monthly for 50 features and using 3. I build the one tool you need, around how you already work.</p>
        <div class="flex items-baseline gap-2 flex-wrap"><span class="text-sm text-[#A9B6C4]">from</span><span class="font-medium text-[64px] tracking-[-0.05em] text-teal leading-none">£{SOFTWARE_FROM}</span><span class="text-sm text-[#A9B6C4]">one-off · fixed price before I start</span></div>
        <div class="flex flex-wrap gap-3 pt-2">
          <Button href="#enquiry" data-type="custom-software" class="pick-type">Get a fixed quote</Button>
          <Button href="/custom-software/" variant="ghost" icon="none">See examples</Button>
        </div>
      </div>
      <div class="p-8 sm:p-10 lg:border-l border-t lg:border-t-0 border-white/10 flex flex-col gap-4">
        <span class="text-[13px] font-semibold text-[#A9B6C4]">Popular builds</span>
        <ul class="tick-list text-[15px] text-[#DCE3EA]">
          <li>Instant quote calculator on your site</li>
          <li>Booking with deposits and reminders</li>
          <li>Job sheets on your phone</li>
          <li>Quote-to-invoice with pay links</li>
          <li>Client portal, stock tracker or staff rota</li>
          <li>30 days of fixes included, and you own it</li>
        </ul>
      </div>
    </div>
    <p class="max-w-[1180px] mx-auto text-center text-sm text-muted mt-8">Setup fee and first month are charged at checkout. Secure payment by Stripe. No VAT added.</p>
  </section>

  <!-- PROMISES -->
  <section class="art px-5 sm:px-6 py-[clamp(72px,8vw,112px)]">
    <img src="/images/art/grid-dark.jpg" alt="" loading="lazy" class="art-bg opacity-75" />
    <div class="art-shade" style="background:linear-gradient(180deg, rgba(7,17,31,0.55) 0%, rgba(7,17,31,0.8) 100%)"></div>
    <div class="art-body max-w-[1240px] mx-auto flex flex-col items-center gap-10 text-center">
      <h2 class="!text-white max-w-[720px] text-[clamp(36px,4vw,54px)] leading-[1.05] tracking-[-0.05em]">Every Plan Comes With My Promises</h2>
      <div class="w-full grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4 text-left">
        <div class="rounded-[22px] p-6 flex flex-col gap-2 text-navy" style="background:linear-gradient(145deg,#2BD98F 0%,#22C7D6 100%)"><span class="font-semibold text-[17px]">Live in about 7 days</span><span class="text-sm text-[#0F3B2A]">from our first call, on most sites</span></div>
        <div class="glass rounded-[22px] p-6 flex flex-col gap-2"><span class="font-semibold text-[17px]">Fixed prices</span><span class="text-sm text-[#A9B6C4]">you know the cost before anything starts</span></div>
        <div class="glass rounded-[22px] p-6 flex flex-col gap-2"><span class="font-semibold text-[17px]">Your content stays yours</span><span class="text-sm text-[#A9B6C4]">words, photos, logo and domain</span></div>
        <div class="glass rounded-[22px] p-6 flex flex-col gap-2"><span class="font-semibold text-[17px]">No long contracts</span><span class="text-sm text-[#A9B6C4]">month to month after the minimum</span></div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="section px-5 sm:px-6">
    <div class="max-w-[1180px] mx-auto flex flex-col gap-9">
      <h2 class="text-[clamp(36px,4vw,54px)] leading-[1.05] tracking-[-0.05em]">Everything You'll Get</h2>
      <div class="overflow-x-auto rounded-[28px] border border-line">
        <table class="w-full min-w-[720px] border-collapse text-[15px]">
          <thead>
            <tr>
              <th scope="col" class="text-left p-6 font-medium text-muted border-b border-[#ECEFEC] w-[34%]">Feature</th>
              {PLANS.map(p => (
                <th scope="col" class={`p-6 border-b border-[#ECEFEC] font-normal ${p.featured ? 'bg-navy text-white' : ''}`}>
                  <span class="flex flex-col items-center gap-1"><span class={`text-[13px] ${p.featured ? 'text-teal' : 'text-muted'}`}>{p.name}</span><span class="plan-price font-medium text-[30px] tracking-[-0.04em]" data-monthly={p.monthly} data-six={p.six} data-rolling={p.rolling}>£{p.monthly}</span></span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map(([f, a, b, c]) => (
              <tr>
                <th scope="row" class="text-left px-6 py-4 font-medium border-b border-[#ECEFEC]">{f}</th>
                <td class="px-6 py-4 text-center border-b border-[#ECEFEC] text-body">{a}</td>
                <td class="px-6 py-4 text-center border-b border-[#ECEFEC] bg-[#EEF7F2] font-semibold">{b}</td>
                <td class="px-6 py-4 text-center border-b border-[#ECEFEC] text-body">{c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ONE-OFF WORK -->
  <section id="one-off" class="px-5 sm:px-6 pb-[clamp(80px,9vw,128px)] scroll-mt-24">
    <div class="max-w-[1180px] mx-auto flex flex-col gap-9">
      <div class="flex flex-wrap justify-between items-end gap-6">
        <div class="flex flex-col gap-5">
          <Eyebrow icon="grid">One-off work</Eyebrow>
          <h2 class="text-[clamp(36px,4vw,54px)] leading-[1.05] tracking-[-0.05em]">Need Something Extra?</h2>
        </div>
        <p class="max-w-[380px] text-[15px] leading-relaxed text-body">On a plan, extra work costs less. The higher the plan, the lower the price. Not on a plan? <a href="#enquiry" class="link-arrow !inline">Ask for a quote</a>.</p>
      </div>
      <div class="overflow-x-auto rounded-[28px] border border-line">
        <table class="w-full min-w-[600px] border-collapse text-left text-[15px]">
          <thead>
            <tr class="text-[13px] text-muted">
              <th class="p-6 font-medium border-b border-[#ECEFEC]">Work</th>
              <th class="p-6 font-medium border-b border-[#ECEFEC]">Get Online</th>
              <th class="p-6 font-medium border-b border-[#ECEFEC] bg-[#EEF7F2]">Get Found</th>
              <th class="p-6 font-medium border-b border-[#ECEFEC]">Get Leads</th>
            </tr>
          </thead>
          <tbody>
            {oneOff.map(r => (
              <tr>
                <td class="px-6 py-4 border-b border-[#ECEFEC]"><p class="font-semibold">{r.service}</p><p class="text-sm text-muted">{r.desc}</p></td>
                <td class="px-6 py-4 border-b border-[#ECEFEC] font-semibold">£{r.starter}</td>
                <td class="px-6 py-4 border-b border-[#ECEFEC] font-semibold bg-[#EEF7F2]">£{r.growth}</td>
                <td class="px-6 py-4 border-b border-[#ECEFEC] font-semibold text-teal-dark">£{r.pro}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ADD-ONS -->
  <section id="add-ons" class="grid-tint section px-5 sm:px-6 scroll-mt-20">
    <div class="max-w-[1180px] mx-auto flex flex-col gap-12">
      <div class="flex flex-col gap-5 max-w-[680px]">
        <Eyebrow icon="bolt" white>Add-ons</Eyebrow>
        <h2 class="h2">Stop Losing The Enquiries You Already Get.</h2>
        <p class="lead">Most clients add one of these once the site is live and they see how many people enquire and then go quiet.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {addOns.map(a => (
          <article class={`rounded-[28px] p-7 flex flex-col gap-4 ${a.best ? 'text-white' : 'bg-white border border-line'}`} style={a.best ? 'background-color:#07111F;background-image:radial-gradient(90% 90% at 100% 0%, rgba(34,199,214,0.45) 0%, rgba(34,199,214,0) 60%), radial-gradient(80% 80% at 0% 100%, rgba(43,217,143,0.4) 0%, rgba(43,217,143,0) 60%)' : ''}>
            {a.best && <span class="chip w-fit !bg-teal">Best value</span>}
            <h3 class={`text-[19px] font-semibold tracking-[-0.02em] ${a.best ? '!text-white' : ''}`}>{a.name}</h3>
            <p class={`text-sm leading-relaxed ${a.best ? 'text-[#B9C4D0]' : 'text-body'}`}>{a.text}</p>
            <p class="flex items-baseline gap-1.5 flex-wrap"><span class={`font-medium text-[40px] tracking-[-0.05em] ${a.best ? 'text-teal' : ''}`}>£{a.monthly}</span><span class={`text-sm ${a.best ? 'text-[#A9B6C4]' : 'text-muted'}`}>/mo + £{a.setup} setup</span></p>
            <ul class={`tick-list text-sm ${a.best ? 'text-[#DCE3EA]' : 'text-body'}`}>{a.items.map(i => <li>{i}</li>)}</ul>
            <a href="#enquiry" data-type="automation" class={`pick-type btn mt-auto ${a.best ? 'btn-grad' : 'btn-soft'}`}>Add this</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ENQUIRY -->
  <section id="enquiry" class="section px-5 sm:px-6 wash scroll-mt-20">
    <div class="max-w-[1240px] mx-auto grid gap-12 lg:grid-cols-[1fr_1.2fr] items-start">
      <div class="flex flex-col gap-6">
        <Eyebrow icon="chat" white>Not sure which plan?</Eyebrow>
        <h2 class="h2">Tell Me What You Need. I'll Send A Fixed Price.</h2>
        <p class="lead max-w-[460px]">A website, more calls from Google, a custom tool, or a mix. Tell me what's going on and I'll recommend the right option, with a price, within one working day.</p>
        <ul class="tick-list text-[17px] text-navy">
          <li>Fixed price before any work starts</li>
          <li>Most websites live in about 7 days</li>
          <li>Custom tools from £{SOFTWARE_FROM}</li>
        </ul>
      </div>
      <EnquiryForm id="pricing-enquiry" heading="Get Your Quote" showBudget />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section px-5 sm:px-6">
    <div class="max-w-[1240px] mx-auto grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div class="flex flex-col gap-5">
        <Eyebrow icon="chat">Questions</Eyebrow>
        <h2 class="h2">Before You Sign Up.</h2>
      </div>
      <div class="faq">
        {faq.map(f => (<details><summary>{f.q}</summary><div>{f.a}</div></details>))}
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  const notes: Record<string, string> = {
    monthly: '3-month minimum, then month to month.',
    six: 'Commit for 6 months and pay the lowest price every month.',
    rolling: "No minimum. Cancel any time with 30 days' notice.",
  };
  const buttons = document.querySelectorAll<HTMLButtonElement>('.term-btn');
  function setTerm(term: string) {
    buttons.forEach(b => {
      const on = b.dataset.term === term;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('bg-navy', on);
      b.classList.toggle('text-white', on);
      b.classList.toggle('font-medium', on);
      b.classList.toggle('text-body', !on);
    });
    document.querySelectorAll<HTMLElement>('.plan-price').forEach(el => {
      el.textContent = '£' + el.dataset[term as 'monthly' | 'six' | 'rolling'];
    });
    document.querySelectorAll<HTMLAnchorElement>('.checkout-btn').forEach(a => {
      a.href = `/api/checkout/${a.dataset.plan}/?term=${term}`;
    });
    const note = document.getElementById('term-note');
    if (note) note.textContent = notes[term];
  }
  buttons.forEach(b => b.addEventListener('click', () => setTerm(b.dataset.term!)));
  setTerm('monthly');

  // Buttons that jump to the enquiry form preselect the matching service
  document.querySelectorAll<HTMLAnchorElement>('.pick-type').forEach(a => {
    a.addEventListener('click', () => {
      const chip = document.querySelector<HTMLButtonElement>(`#pricing-enquiry .pick[data-value="${a.dataset.type}"]`);
      if (chip && chip.getAttribute('aria-pressed') !== 'true') chip.click();
    });
  });
</script>
