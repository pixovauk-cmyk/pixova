            <span class="text-xs pb-2" style="color:#8a9ab0;">/month</span>
          </div>
          <p class="text-xs mb-1 plan-term" data-six="6-month minimum" data-annual="12-month minimum" data-rolling="Cancel anytime (30 days notice)" style="color:#8a9ab0;">6-month minimum</p>
          <p class="text-xs font-semibold mb-5 plan-save hidden annual-badge" style="color:#2ECC9A;">Save £150 on setup + £240 over year</p>
          <p class="text-xs font-semibold mb-5 plan-save hidden rolling-badge" style="color:#8a9ab0;">Flexible, no commitment</p>
          <p class="text-xs font-semibold mb-5 plan-save six-badge" style="color:#2ECC9A;">Nothing to pay until live</p>

          <ul class="flex flex-col gap-2.5 flex-1 mb-6">
            {[
              'Everything in Growth',
              '12 pages built (full service breakdown)',
              '2 SEO blog posts per month',
              '6 content updates per month',
              'Google Business Profile managed weekly',
              'Monthly competitor ranking report',
              'Same-day emergency fixes',
              'WhatsApp direct access',
              'Quarterly 30-min strategy call',
            ].map(item => (
              <li class="flex items-start gap-2 text-xs" style="color:#4a6070;">
                <span class="flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center mt-0.5" style="background:#E8F5F1; color:#2ECC9A; font-size:9px;">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <a href="/about/#contact" class="block text-center text-sm font-semibold py-3 rounded-xl transition-colors" style="background:#E8F5F1; color:#1C3557;">
            Get started →
          </a>
        </div>

      </div>

      <!-- Footer note -->
      <p class="text-xs mt-6 text-center" style="color:#8a9ab0;">
        All plans: live in 7 working days or first month free. You own the site. No lock-in beyond the minimum term.
      </p>

    </div>
  </section>

  <script>
    const termBtns = document.querySelectorAll('.term-btn');
    const setupEls = document.querySelectorAll('.plan-setup');
    const monthlyEls = document.querySelectorAll('.plan-monthly');
    const termEls = document.querySelectorAll('.plan-term');
    const annualBadges = document.querySelectorAll('.annual-badge');
    const rollingBadges = document.querySelectorAll('.rolling-badge');
    const sixBadges = document.querySelectorAll('.six-badge');

    function switchTerm(term) {
      setupEls.forEach(el => {
        el.textContent = el.dataset[term];
        el.style.color = term === 'annual' ? '#2ECC9A' : (el.closest('[style*="0D2240"]') ? '#2ECC9A' : '#1C3557');
      });
      monthlyEls.forEach(el => { el.textContent = el.dataset[term]; });
      termEls.forEach(el => { el.textContent = el.dataset[term]; });

      annualBadges.forEach(el => el.classList.toggle('hidden', term !== 'annual'));
      rollingBadges.forEach(el => el.classList.toggle('hidden', term !== 'rolling'));
      sixBadges.forEach(el => el.classList.toggle('hidden', term !== 'six'));

      termBtns.forEach(btn => {
        const active = btn.dataset.term === term;
        if (btn.dataset.term === 'annual') {
          btn.style.background = active ? '#2ECC9A' : '#fff';
          btn.style.color = active ? '#0D2240' : '#1C3557';
          btn.style.borderColor = active ? '#2ECC9A' : '#e5e7eb';
        } else {
          btn.style.background = active ? '#0D2240' : '#fff';
          btn.style.color = active ? '#fff' : '#1C3557';
          btn.style.borderColor = active ? '#0D2240' : '#e5e7eb';
        }
      });
    }

    // Default to 12-month
    switchTerm('annual');

    termBtns.forEach(btn => {
      btn.addEventListener('click', () => switchTerm(btn.dataset.term));
    });
  </script>

