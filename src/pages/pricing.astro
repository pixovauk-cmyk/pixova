---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Local SEO Packages & Web Design Prices | Pixova Birmingham"
  description="Affordable local SEO packages and web design prices for UK small businesses. From £49/month. Setup fee paid on go-live. Birmingham-based."
  canonicalUrl="https://www.pixova.uk/pricing/"
>

  <!-- HERO -->
  <section class="relative pt-20 pb-16 overflow-hidden" style="background:#0D2240; min-height:340px;">
    <div class="absolute inset-0" style="background-image:url('/images/pricing-hero.webp'); background-size:cover; background-position:center; opacity:0.55;"></div>
    <div class="absolute inset-0" style="background:linear-gradient(135deg, rgba(13,34,64,0.82) 0%, rgba(28,53,87,0.55) 50%, rgba(13,34,64,0.82) 100%);"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
      <span class="text-xs font-semibold tracking-widest uppercase" style="color:#2ECC9A;">PRICING</span>
      <h1 class="font-heading font-semibold text-4xl sm:text-5xl mt-3 mb-5" style="color:#fff;">
        Local SEO Packages &amp; Web Design Prices for Small Businesses.
      </h1>
      <p class="text-base max-w-2xl leading-relaxed" style="color:rgba(255,255,255,0.72);">
        You want to know what it costs. Fair enough.

        My local SEO packages start from £49/month. I build first, you pay the setup fee when it goes live. One monthly fee covers everything after that.

        No hidden costs. Birmingham-based.
      </p>
      <!-- Trust indicators -->
      <div class="flex flex-wrap items-center gap-4 mt-7">
        {[
          'Nothing to pay until live',
          'Live in 7 working days',
          'You own the site',
          'Cancel after minimum term',
        ].map(item => (
          <span class="flex items-center gap-1.5 text-xs font-medium" style="color:rgba(255,255,255,0.75);">
            <span style="color:#2ECC9A;">✓</span> {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- GROUP 1: Monthly plans -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="max-w-2xl mb-10">
        <span class="text-xs font-semibold tracking-widest uppercase" style="color:#2ECC9A;">WEBSITE PLANS</span>
        <h2 class="font-heading font-semibold text-3xl mt-3 mb-3" style="color:#1C3557;">
          Affordable Local SEO Packages and Web Design Plans.
        </h2>
        <p class="text-sm leading-relaxed" style="color:#4a6070;">
          Inexpensive web design built properly. Setup fee paid on go-live, nothing before that. Monthly fee covers hosting, content updates, SEO, and support. Pick your plan, choose your term.
        </p>
      </div>

      <!-- June offer banner -->
      <div class="flex items-center gap-3 rounded-xl px-4 py-3 mb-8 flex-wrap" style="background:#FEF2F2; border:1px solid #FECACA;">
        <span class="flex-shrink-0 text-xs font-black uppercase tracking-wider px-2 py-1 rounded-md" style="background:#DC2626; color:#fff;">June offer</span>
        <p class="text-sm font-semibold" style="color:#991B1B;">Setup fees reduced on all plans. 3 spots left this month. Closes 30 June.</p>
      </div>

      <!-- Term toggle -->
      <div class="flex items-center gap-2 mb-8 flex-wrap">
        <button class="term-btn text-xs font-bold px-4 py-2 rounded-full border transition-all" data-term="six" style="background:#fff; color:#1C3557; border-color:#e5e7eb;">
          6 months
        </button>
        <button class="term-btn active-term text-xs font-bold px-4 py-2 rounded-full border transition-all relative" data-term="annual" style="background:#2ECC9A; color:#0D2240; border-color:#2ECC9A;">
          12 months, best value
          <span class="absolute -top-2.5 -right-2 text-[9px] font-black px-1.5 py-0.5 rounded-full" style="background:#0D2240; color:#2ECC9A;">★</span>
        </button>
        <button class="term-btn text-xs font-bold px-4 py-2 rounded-full border transition-all" data-term="rolling" style="background:#fff; color:#1C3557; border-color:#e5e7eb;">
          Rolling monthly
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        <!-- Plan 1: Starter -->
        <div class="rounded-2xl border p-6 flex flex-col" style="border-color:#e5e7eb;">
          <span class="text-xs font-semibold tracking-widest uppercase mb-3" style="color:#8a9ab0;">STARTER</span>
          <h3 class="font-heading font-bold text-xl mb-4" style="color:#1C3557;">Get Online</h3>

          <!-- Setup fee -->
          <div class="rounded-xl px-4 py-3 mb-4 flex items-center justify-between" style="background:#f7fafa;">
            <span class="text-xs font-semibold" style="color:#4a6070;">Setup fee (paid on go-live)</span>
            <span class="font-bold text-base plan-setup" data-six="£99" data-annual="£49" data-rolling="£169" style="color:#1C3557;">£49</span>
