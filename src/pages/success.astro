---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
---

<Layout
  title="Payment Confirmed | Pixova"
  description="Your Pixova plan is confirmed."
  canonicalUrl="https://www.pixova.uk/success/"
  noindex={true}
>
  <section class="section min-h-[70vh] flex items-center">
    <div class="wrap-narrow text-center">
      <div class="w-16 h-16 rounded-full bg-mint flex items-center justify-center mx-auto">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#17A57A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1 class="h2 mt-6">You're in. Payment confirmed.</h1>
      <p class="lead mt-4">A welcome email is on its way with what happens next, and Stripe will send your receipt separately. I'll be in touch within one working day to book your kick-off call.</p>
      <div class="card p-6 mt-10 text-left">
        <p class="font-semibold text-navy">To get a head start, send me:</p>
        <ul class="tick-list mt-4 text-sm">
          <li>Your logo, if you have one</li>
          <li>A few photos of your work, team or premises</li>
          <li>Links to any websites you like the look of</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-3 justify-center mt-8">
        <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn btn-primary">Send them on WhatsApp</a>
        <a href={`mailto:${SITE.email}`} class="btn btn-outline">Email instead</a>
      </div>
    </div>
  </section>
</Layout>
