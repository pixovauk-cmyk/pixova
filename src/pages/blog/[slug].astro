---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const postTitle = post.data.title ?? post.id.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

const pubDateISO = post.data.pubDate.toISOString();
const updatedDateISO = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pixova.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://pixova.uk/blog/' },
    { '@type': 'ListItem', position: 3, name: postTitle, item: `https://pixova.uk/blog/${post.id}/` },
  ],
};
---

<Layout
  title={`${post.data.seoTitle ?? postTitle} | Pixova`}
  description={post.data.description}
  canonicalUrl={`https://pixova.uk/blog/${post.id}/`}
  ogImage={post.data.heroImage}
  articleSchema={{
    headline: postTitle,
    datePublished: pubDateISO,
    dateModified: updatedDateISO,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- POST HEADER ─────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-24 pb-0" style="background-color:#0D2240;">
    <div class="orb absolute pointer-events-none" style="width:400px; height:400px; top:-60px; right:-60px; border-radius:50%; background:radial-gradient(circle, rgba(46,204,154,0.08) 0%, transparent 65%);"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 relative pb-10">
      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <a href="/blog" class="text-xs font-medium transition-opacity hover:opacity-70" style="color:#2ECC9A;">
          ← Back to blog
        </a>
        <span style="color:rgba(255,255,255,0.2);">·</span>
        <time datetime={pubDateISO} class="text-xs" style="color:rgba(255,255,255,0.4);">
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.readTime && (
          <>
            <span style="color:rgba(255,255,255,0.2);">·</span>
            <span class="text-xs" style="color:rgba(255,255,255,0.4);">{post.data.readTime}</span>
          </>
        )}
      </div>
      <h1 class="font-heading font-semibold text-3xl sm:text-4xl leading-tight" style="color:#fff;">
        {postTitle}
      </h1>
    </div>

    <!-- Hero image flush to bottom of dark header -->
    {post.data.heroImage && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="rounded-t-2xl overflow-hidden" style="height:clamp(180px, 35vw, 380px);">
          <img
            src={post.data.heroImage}
            alt={postTitle}
            width="1200" height="500"
            loading="eager" fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    )}
  </section>

  <!-- ARTICLE ─────────────────────────────────────────── -->
  <article class="py-16 bg-offwhite">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <!-- Body -->
      <div class="prose-content">
        <Content />
      </div>

      <!-- Author -->
      <div class="mt-12 pt-8 border-t border-gray-200 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0" style="background-color:#E8F5F1;">
          <span class="font-heading font-bold text-sm" style="color:#1C3557;">AJ</span>
        </div>
        <div>
          <p class="text-sm font-semibold" style="color:#1C3557;">Anil Jaishi</p>
          <p class="text-xs" style="color:#1A2E3D; opacity:0.6;">Founder, Pixova · Digital Marketing, University of Birmingham</p>
        </div>
      </div>

      <!-- Related internal links -->
      <div class="mt-10 p-6 rounded-xl" style="background-color:#E8F5F1;">
        <p class="text-sm font-semibold mb-3" style="color:#1C3557;">You might also find useful:</p>
        <ul class="space-y-2">
          <li>
            <a href="/about#contact" class="text-sm hover:opacity-80 transition-opacity" style="color:#2ECC9A;">
              Get a free website review from Pixova
            </a>
          </li>
          <li>
            <a href="/blog" class="text-sm hover:opacity-80 transition-opacity" style="color:#2ECC9A;">
              More guides from the Pixova blog
            </a>
          </li>
        </ul>
      </div>

    </div>
  </article>

  <!-- CTA SECTION ─────────────────────────────────────── -->
  <section class="py-16" style="background-color:#0D2240;">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <span class="sec-label mb-4 block">READY TO GROW?</span>
      <h2 class="font-heading font-semibold text-2xl sm:text-3xl mb-4" style="color:#fff;">
        Want us to handle this for you?
      </h2>
      <p class="mb-6 max-w-lg mx-auto" style="color:rgba(255,255,255,0.55);">
        We handle web design, local SEO, and AI automation for small businesses across the UK.
        Let's have a quick chat about your business.
      </p>
      <a href="/about#contact" class="btn-p">
        Get in touch
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

</Layout>

<style is:global>
  .prose-content {
    color: #1A2E3D;
    font-size: 1rem;
    line-height: 1.75;
  }
  .prose-content h2 {
    font-family: "DM Sans", sans-serif;
    font-weight: 600;
    font-size: 1.4rem;
    color: #1C3557;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .prose-content h3 {
    font-family: "DM Sans", sans-serif;
    font-weight: 600;
    font-size: 1.15rem;
    color: #1C3557;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose-content p {
    margin-bottom: 1.2rem;
  }
  .prose-content strong {
    font-weight: 600;
    color: #1C3557;
  }
  .prose-content a {
    color: #2ECC9A;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-content a:hover {
    opacity: 0.8;
  }
  .prose-content ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .prose-content ol {
    list-style: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .prose-content li {
    margin-bottom: 0.4rem;
  }
  .prose-content hr {
    border: none;
    border-top: 1px solid #E8F5F1;
    margin: 2.5rem 0;
  }
  .prose-content blockquote {
    border-left: 3px solid #2ECC9A;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #1A2E3D;
    opacity: 0.8;
    font-style: italic;
  }
</style>
