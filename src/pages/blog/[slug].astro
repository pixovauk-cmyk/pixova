---
import Layout from '../../layouts/Layout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'>; }

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2);

const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const postTitle = post.data.title ?? post.id.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
const pubDateISO = post.data.pubDate.toISOString();
const updatedDateISO = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const url = `https://www.pixova.uk/blog/${post.id}/`;
const topic = post.id.includes('seo') ? 'Local SEO' : post.id.includes('automation') ? 'Automation' : 'Web design';

// Split the title so the bracketed tail (or part after a colon) gets the gradient
const m = postTitle.match(/^(.*?)(\s\(.*\)|:\s.*)$/);
const titleHead = m ? m[1] : postTitle;
const titleTail = m ? m[2] : '';

const others = (await getCollection('blog'))
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout
  title={`${post.data.seoTitle ?? postTitle} | Pixova`}
  description={post.data.description}
  canonicalUrl={url}
  ogImage={post.data.heroImage}
  articleSchema={{ headline: postTitle, datePublished: pubDateISO, dateModified: updatedDateISO }}
  breadcrumbs={[
    { name: 'Home', url: 'https://www.pixova.uk/' },
    { name: 'Blog', url: 'https://www.pixova.uk/blog/' },
    { name: postTitle, url },
  ]}
>
  <article>
    <header class="px-5 sm:px-6 pt-10">
      <div class="max-w-[1000px] mx-auto flex flex-col items-center gap-[22px] text-center">
        <nav aria-label="Breadcrumb" class="flex flex-wrap justify-center gap-2 text-sm text-muted"><a href="/blog/" class="text-navy font-medium">Blog</a><span aria-hidden="true">/</span><span>{topic}</span></nav>
        <h1 class="font-medium text-[clamp(38px,5.2vw,72px)] leading-none tracking-[-0.05em]">{titleHead}{titleTail && <span class="grad-text">{titleTail}</span>}</h1>
        <div class="flex flex-wrap justify-center items-center gap-3 text-sm text-body">
          <img src="/images/anil.webp" alt="" width="40" height="40" class="w-10 h-10 rounded-full object-cover object-top" />
          <a href="/about/" class="font-semibold text-navy">Anil Jaishi</a><span>·</span><time datetime={pubDateISO}>{formatDate(post.data.pubDate)}</time>{post.data.readTime && <><span>·</span><span>{post.data.readTime}</span></>}
        </div>
      </div>
      <div class="relative max-w-[1240px] mx-auto mt-11 h-[clamp(240px,36vw,480px)] rounded-[36px] overflow-hidden bg-navy shadow-[0_50px_100px_-50px_rgba(7,17,31,0.6)]">
        <img src={post.data.heroImage ?? '/images/art/orb-dark.jpg'} alt="" width="1240" height="480" loading="eager" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover" />
      </div>
    </header>

    <section class="px-5 sm:px-6 pt-[clamp(48px,6vw,80px)] pb-[clamp(72px,8vw,112px)]">
      <div class="max-w-[1180px] mx-auto flex flex-wrap gap-12 items-start">
        <div class="flex-[999_1_620px] min-w-0">
          <div class="prose-content"><Content /></div>

          <aside class="mt-12 p-7 rounded-[26px] flex flex-wrap justify-between items-center gap-4" style="background:var(--grad)">
            <span class="flex flex-col gap-1 max-w-[420px]"><strong class="text-[22px] tracking-[-0.03em] text-navy">See where you stand today.</strong><span class="text-[15px] leading-normal text-[#073B2B]">Free Gap Report: who's ranking above you on Google, and why.</span></span>
            <a href="/gap-report/" class="btn btn-dark">Get my report</a>
          </aside>
        </div>

        <aside class="flex-[1_1_280px] min-w-0 flex flex-col gap-4 lg:sticky lg:top-28">
          {toc.length > 0 && (
            <nav aria-label="On this page" class="rounded-[24px] bg-[#F7F9F8] border border-line p-6 flex flex-col gap-1">
              <span class="mono text-[11px] tracking-[0.14em] text-muted mb-2">ON THIS PAGE</span>
              {toc.map(h => <a href={`#${h.slug}`} class="py-2 text-navy text-[15px] leading-snug hover:text-teal-dark">{h.text}</a>)}
            </nav>
          )}
          <div class="art rounded-[24px] p-6 flex flex-col gap-3.5">
            <img src="/images/art/aurora-dark.jpg" alt="" loading="lazy" class="art-bg opacity-80" />
            <div class="art-body flex items-center gap-3"><img src="/images/anil.webp" alt="Anil Jaishi" width="48" height="48" class="w-12 h-12 rounded-full object-cover object-top" /><span class="flex flex-col"><span class="font-semibold">Anil Jaishi</span><span class="text-[13px] text-[#C8D3DD]">Founder, Pixova</span></span></div>
            <p class="art-body m-0 text-sm leading-relaxed text-[#DCE3EA]">Builds websites, local SEO and small custom software for small businesses across the UK. Answers his own phone.</p>
            <a href={SITE.whatsapp} target="_blank" rel="noopener" class="art-body btn btn-grad btn-sm">Ask Anil a question</a>
          </div>
          {others.length > 0 && (
            <div class="rounded-[24px] bg-[#F7F9F8] border border-line p-6 flex flex-col gap-3">
              <span class="mono text-[11px] tracking-[0.14em] text-muted">READ NEXT</span>
              {others.map(p => <a href={`/blog/${p.id}/`} class="text-navy font-semibold leading-snug hover:text-teal-dark">{p.data.title}</a>)}
            </div>
          )}
        </aside>
      </div>
    </section>
  </article>

  <section class="section px-5 sm:px-6 grid-tint">
    <div class="max-w-[1240px] mx-auto grid gap-12 lg:grid-cols-[1fr_1.2fr] items-start">
      <div class="flex flex-col gap-6">
        <Eyebrow icon="chat" white>Want this done for you?</Eyebrow>
        <h2 class="h2">Skip The Reading. I'll Sort It.</h2>
        <p class="lead max-w-[460px]">Tell me about your business. I'll reply within one working day with what I'd do and a fixed price.</p>
      </div>
      <EnquiryForm id="post-enquiry" />
    </div>
  </section>
</Layout>
