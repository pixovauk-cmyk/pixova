---
import Layout from '../../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pixova.uk/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://pixova.uk/about/' },
  ],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Pixova',
  url: 'https://pixova.uk',
  logo: 'https://pixova.uk/favicon.svg',
  description: 'Pixova builds fast, SEO-ready websites and handles local SEO for small and medium businesses across the UK. Based in Birmingham.',
  telephone: '+447786366109',
  email: 'hello@pixova.uk',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Birmingham',
    addressRegion: 'England',
    addressCountry: 'GB',
  },
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  founder: {
    '@type': 'Person',
    name: 'Anil Jaishi',
    url: 'https://www.linkedin.com/in/anil-jaishi-150050208/',
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Birmingham' },
  },
  sameAs: [
    'https://www.facebook.com/profile.php?id=61589529080471',
    'https://www.linkedin.com/in/anil-jaishi-150050208/',
  ],
};
---

<Layout
  title="About Pixova | Birmingham Digital Agency | Anil Jaishi"
  description="Pixova is a Birmingham digital agency helping small businesses get found on Google. AI-powered web design and local SEO — no jargon, no long contracts."
  canonicalUrl="https://pixova.uk/about/"
  schema={localBusinessSchema}
>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- PAGE HERO ───────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-24 pb-16">
    <!-- Background: team photo with dark overlay -->
    <div class="absolute inset-0">
      <img
        src="/images/hero-collage.webp"
        alt=""
        width="1400" height="781"
        loading="eager" fetchpriority="high"
        class="w-full h-full object-cover"
        aria-hidden="true"
      />
      <div class="absolute inset-0" style="background:linear-gradient(135deg, rgba(13,34,64,0.93) 0%, rgba(13,34,64,0.82) 60%, rgba(13,34,64,0.75) 100%);"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative">
      <div class="max-w-2xl">
        <span class="sec-label mb-4 block">ABOUT PIXOVA</span>
        <h1 class="font-heading font-semibold text-4xl sm:text-5xl mt-3 mb-5" style="color:#fff;">
          We're Pixova — a Birmingham digital agency built for small businesses.
        </h1>
        <p class="text-base leading-relaxed" style="color:rgba(255,255,255,0.6);">
          Based in Birmingham. Serving the whole of the UK.
          No long contracts, no confusing jargon — just websites and SEO
          that actually bring in customers.
        </p>

        <!-- Credential pills -->
        <div class="flex flex-wrap gap-2 mt-8">
          <span class="pill">Digital Marketing Graduate</span>
          <span class="pill">University of Birmingham</span>
          <span class="pill">AI-powered builds</span>
          <span class="pill">UK-wide</span>
        </div>
      </div>
    </div>
  </section>


  <!-- ABOUT STORY ─────────────────────────────────────── -->
  <section class="py-20 bg-offwhite">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

        <!-- Photo -->
        <div class="relative reveal">
          <div class="rounded-2xl overflow-hidden shadow-lg" style="background-color:#1C3557; min-height:420px;">
            <img
              src="/images/anil.webp"
              alt="Anil Jaishi, founder of Pixova — web design and SEO agency based in Birmingham"
              width="560" height="620"
              loading="lazy"
              class="w-full h-full object-cover object-top"
              onerror="this.parentElement.style.display='flex'; this.parentElement.style.alignItems='center'; this.parentElement.style.justifyContent='center'; this.style.display='none';"
            />
            <div class="hidden absolute inset-0 flex items-center justify-center flex-col p-8 text-center">
              <div class="w-20 h-20 rounded-full flex items-center justify-center mb-4" style="background-color:#2ECC9A;">
                <span class="font-heading font-bold text-2xl" style="color:#1C3557;">AJ</span>
              </div>
              <p class="text-white font-semibold">Anil Jaishi</p>
              <p class="text-white/60 text-sm">Founder, Pixova</p>
            </div>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-4 -right-4 bg-white rounded-xl shadow-md px-5 py-4">
            <p class="font-heading font-semibold text-sm" style="color:#1C3557;">University of Birmingham</p>
            <p class="text-xs mt-0.5" style="color:#2ECC9A;">Digital Marketing Graduate</p>
          </div>
        </div>

        <!-- Story text -->
        <div>
          <span class="sec-label reveal">WHY I STARTED PIXOVA</span>
          <h2 class="font-heading font-semibold text-3xl sm:text-4xl mt-3 mb-6 reveal reveal-d1" style="color:#1C3557;">
            Fed up with agencies that overpromise and underdeliver.
          </h2>

          <div class="space-y-4 text-sm leading-relaxed" style="color:#1A2E3D;">
            <p>
              I started Pixova because I kept seeing the same thing. Small businesses
              paying thousands for a website that looked fine but did nothing.
              No rankings. No enquiries. Just a nice-looking page nobody ever found.
            </p>
            <p>
              The problem wasn't the businesses. It was the agencies. Big pitches,
              complicated proposals, and no one who could explain in plain English
              what they were actually building or why it would work.
            </p>
            <p>
              Pixova is different in the way that actually matters: we build websites
              with SEO from the first line of code, not as an afterthought. Then we
              manage everything — so you never have to think about it again.
            </p>
            <p>
              We use AI to build faster and smarter. But every site is reviewed, refined,
              and backed by a real strategy. Birmingham-based, UK-wide, and always
              available when you need something sorted.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-5 mt-8">
            {[
              { icon:'🎓', label:'Digital Marketing, University of Birmingham' },
              { icon:'📍', label:'Based in Birmingham, serving the whole of the UK' },
              { icon:'⚡', label:'AI-built websites that rank from day one' },
              { icon:'🔧', label:'Fully managed — you never touch a thing' },
            ].map(item => (
              <div class="flex items-start gap-3">
                <span class="text-lg">{item.icon}</span>
                <p class="text-xs leading-relaxed" style="color:#1A2E3D;">{item.label}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- WHAT MAKES US DIFFERENT ─────────────────────────── -->
  <section class="py-16" style="background-color:#0D2240;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <span class="sec-label reveal">WHY PIXOVA</span>
        <h2 class="font-heading font-semibold text-3xl mt-3 reveal reveal-d1" style="color:#fff;">
          Three things a Birmingham web designer should get right.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          {
            title: 'Built with AI, not excuses',
            desc: 'We use AI to build faster and cheaper than a traditional agency — without sacrificing quality. Every site is reviewed, refined, and tested by a human before it goes live.',
          },
          {
            title: 'Managed completely',
            desc: "Message us a change, we do it the same day. Hosting, updates, security — all handled. You're not buying a website. You're buying something that runs itself.",
          },
          {
            title: 'Actually ranked',
            desc: 'Every site is built with SEO from the first line of code. Not added on at the end. Not an optional extra. Every page, every heading, every image — built to rank.',
          },
        ].map((item, i) => (
          <div class={`glass-card p-7 reveal ${i === 1 ? 'reveal-d1' : i === 2 ? 'reveal-d2' : ''}`}>
            <div class="w-8 h-1 rounded-full mb-5" style="background-color:#2ECC9A;"></div>
            <h3 class="font-heading font-semibold text-lg mb-3" style="color:#fff;">{item.title}</h3>
            <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.6);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- CONTACT FORM ────────────────────────────────────── -->
  <section id="contact" class="py-20 bg-offwhite">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">

        <!-- Left: CTA copy -->
        <div>
          <span class="sec-label">GET IN TOUCH</span>
          <h2 class="font-heading font-semibold text-3xl sm:text-4xl mt-3 mb-5" style="color:#1C3557;">
            Let's have a chat.
          </h2>
          <p class="text-sm leading-relaxed mb-8" style="color:#1A2E3D;">
            Tell us a bit about your business. We'll come back to you within 24 hours —
            no pressure, no pitch, just a straight conversation about what you need.
          </p>

          <div class="space-y-4">
            <a
              href="https://wa.me/447786366109"
              target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-3 text-sm font-medium hover:opacity-80 transition-opacity"
              style="color:#1A2E3D;"
            >
              <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background-color:#E8F5F1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#2ECC9A" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <span>+44 7786 366109 via WhatsApp</span>
            </a>
            <a
              href="mailto:hello@pixova.uk"
              class="flex items-center gap-3 text-sm font-medium hover:opacity-80 transition-opacity"
              style="color:#1A2E3D;"
            >
              <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background-color:#E8F5F1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <span>hello@pixova.uk</span>
            </a>
          </div>

          <p class="text-xs mt-6" style="color:#1A2E3D; opacity:0.6;">
            We reply within 24 hours. Usually much faster.
          </p>
        </div>

        <!-- Right: form -->
        <div class="bg-white rounded-2xl shadow-sm p-8">

          <!-- Thank you panel -->
          <div id="form-success" class="hidden text-center py-8">
            <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5" style="background-color:#E8F5F1;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <h3 class="font-heading font-semibold text-xl mb-3" style="color:#1C3557;">Thanks, we've got your message!</h3>
            <p class="text-sm leading-relaxed mb-2" style="color:#1A2E3D;">
              We'll be back in touch within 24 hours.
            </p>
            <p class="text-sm" style="color:#6B7580;">
              While you wait, feel free to browse the blog or message us on WhatsApp if it's urgent.
            </p>
            <a
              href="https://wa.me/447786366109"
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-6 font-semibold text-sm px-5 py-3 rounded-lg"
              style="background-color:#2ECC9A; color:#0D2240;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Message us on WhatsApp
            </a>
          </div>

          <form
            action="https://formspree.io/f/mlgzlnqn"
            method="POST"
            id="contact-form"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div>
                <label for="name" class="block text-xs font-semibold mb-1.5" style="color:#1C3557;">Name <span style="color:#2ECC9A;">*</span></label>
                <input
                  type="text" id="name" name="name" required
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-teal transition-colors"
                  style="color:#1A2E3D; background:#fff;"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="business" class="block text-xs font-semibold mb-1.5" style="color:#1C3557;">Business name <span style="color:#2ECC9A;">*</span></label>
                <input
                  type="text" id="business" name="business_name" required
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-teal transition-colors"
                  style="color:#1A2E3D;"
                  placeholder="Your business"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div>
                <label for="phone" class="block text-xs font-semibold mb-1.5" style="color:#1C3557;">Phone <span style="color:#2ECC9A;">*</span></label>
                <input
                  type="tel" id="phone" name="phone" required
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-teal transition-colors"
                  style="color:#1A2E3D;"
                  placeholder="07xxx xxxxxx"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-semibold mb-1.5" style="color:#1C3557;">Email <span style="color:#2ECC9A;">*</span></label>
                <input
                  type="email" id="email" name="email" required
                  class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-teal transition-colors"
                  style="color:#1A2E3D;"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <div class="mb-4">
              <fieldset>
                <legend class="block text-xs font-semibold mb-2" style="color:#1C3557;">What do you need help with? <span style="color:#2ECC9A;">*</span></legend>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {[
                    { value: 'free-site', label: '🎁 Free website (limited — 5 spots)', highlight: true },
                    { value: 'new-website', label: 'A new website' },
                    { value: 'seo', label: 'SEO and getting found on Google' },
                    { value: 'both', label: 'Both — website and SEO' },
                    { value: 'automation', label: 'AI & marketing automation' },
                    { value: 'not-sure', label: "Not sure yet — happy to chat" },
                  ].map(opt => (
                    <label class={`flex items-center gap-2.5 cursor-pointer p-3 rounded-lg border transition-colors text-xs font-medium ${opt.highlight ? 'border-yellow-400 bg-yellow-50' : 'border-gray-200 hover:border-teal'}`} style={opt.highlight ? 'color:#92660a;' : 'color:#1A2E3D;'}>
                      <input type="radio" name="help_type" value={opt.value} required class="accent-teal w-4 h-4 flex-shrink-0" id={`radio-${opt.value}`} />
                      {opt.label}
                    </label>
                  ))}
                </div>
              </fieldset>
            </div>

            <div class="mb-4">
              <label for="message" class="block text-xs font-semibold mb-1.5" style="color:#1C3557;">Tell us a bit about your business <span style="color:#2ECC9A;">*</span></label>
              <textarea
                id="message" name="message" required rows="4"
                class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-teal transition-colors resize-none"
                style="color:#1A2E3D;"
                placeholder="What do you do, where are you based, what's the main problem you're trying to solve..."
              ></textarea>
            </div>

            <div class="mb-6">
              <label for="source" class="block text-xs font-semibold mb-1.5" style="color:#1C3557;">How did you find us? <span class="font-normal" style="color:#6B7580;">(optional)</span></label>
              <select
                id="source" name="source"
                class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-teal transition-colors"
                style="color:#1A2E3D; background:#fff;"
              >
                <option value="">Select one...</option>
                <option value="google">Google search</option>
                <option value="word-of-mouth">Word of mouth</option>
                <option value="social">Social media</option>
                <option value="other">Other</option>
              </select>
            </div>

            <button
              type="submit"
              class="w-full font-semibold text-sm py-4 rounded-lg transition-colors min-h-[48px]"
              style="background-color:#2ECC9A; color:#0D2240;"
            >
              Send my enquiry
            </button>

            <div id="form-error" class="hidden mt-4 p-4 rounded-lg text-sm text-center" style="background-color:#fff0f0; color:#c0392b;">
              Something went wrong. Please email us at hello@pixova.uk
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  // Auto-select free site option if arriving via offer link
  if (new URLSearchParams(window.location.search).get('offer') === 'free-site') {
    const radio = document.getElementById('radio-free-site') as HTMLInputElement;
    if (radio) radio.checked = true;
  }

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');
  const error = document.getElementById('form-error');
  const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } else {
        error?.classList.remove('hidden');
        if (btn) { btn.disabled = false; btn.textContent = 'Send my enquiry'; }
      }
    } catch {
      error?.classList.remove('hidden');
      if (btn) { btn.disabled = false; btn.textContent = 'Send my enquiry'; }
    }
  });
</script>
