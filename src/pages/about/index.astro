---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Icon from '../../components/Icon.astro';
import Testimonials from '../../components/Testimonials.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { SITE } from '../../data/site';

const values = [
  { t: 'Prices on the page', s: 'Every plan and price is on this website. You know the cost before we speak, and it does not change after.' },
  { t: 'Built with AI. Checked by a human.', s: 'AI makes the build faster and cheaper. I still review, refine and test every page by hand before it goes anywhere near your customers.', dark: true },
  { t: 'Help when you need it', s: 'Changes usually done the same day. Replies within one working day, often within minutes.' },
  { t: 'No long contracts', s: 'Short minimum terms, then month to month. Your content, photos and domain stay yours.' },
];

const promises = [
  { icon: 'bolt', t: 'Live in about 7 days', s: 'Most sites go from first call to live in a single working week.' },
  { icon: 'shield', t: 'Managed completely', s: "Hosting, updates, security and backups. You never have to touch a thing.", dark: true },
  { icon: 'trend', t: 'Set up for Google', s: 'Titles, page speed and local details done from day one, not sold later as an extra.' },
  { icon: 'chat', t: 'A report you can read', s: 'One page each month: where you rank, how many people got in touch, what I am doing next.' },
  { icon: 'clock', t: 'You deal with me', s: 'No account managers or tickets. The person you speak to is the person who builds it.' },
  { icon: 'lock', t: 'Fixed prices', s: 'You know the cost before anything starts. No surprise bills, ever.' },
];
---

<Layout
  title="About Pixova | Anil Jaishi, Birmingham Web Designer"
  description="Pixova is run by Anil Jaishi in Birmingham. Websites, local SEO and small custom software for UK small businesses, Fixed prices, live in about 7 days."
  canonicalUrl="https://www.pixova.uk/about/"
  breadcrumbs={[{ name: 'Home', url: 'https://www.pixova.uk/' }, { name: 'About', url: 'https://www.pixova.uk/about/' }]}
>
  <!-- HERO -->
  <section class="px-5 sm:px-6 pt-10 sm:pt-14 pb-20">
    <div class="max-w-[1240px] mx-auto flex flex-col gap-12">
      <div class="grid gap-x-16 gap-y-8 lg:grid-cols-2 items-end">
        <div class="flex flex-col gap-6">
          <Eyebrow icon="user">About Pixova</Eyebrow>
          <h1 class="font-medium text-[clamp(46px,5.6vw,80px)] leading-none tracking-[-0.055em]">Hi, I'm Anil. I Built A Better Agency For <span class="grad-text">Small Business.</span></h1>
        </div>
        <div class="flex flex-col items-start gap-5">
          <p class="text-base leading-relaxed text-body max-w-[480px]">I started Pixova because I kept meeting small business owners who'd paid thousands for a website that looked fine and did nothing. No calls. No enquiries. And nobody could tell them why.</p>
          <p class="text-base leading-relaxed text-body max-w-[480px]">So I do it differently. I build with Google in mind from day one, write the words for you, and keep looking after it every month. When you need something changed, you message me, not a ticket system.</p>
          <Button href="#contact">Got a project in mind?</Button>
        </div>
      </div>
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v, i) => v.dark ? (
          <div class="relative overflow-hidden rounded-[24px] p-[26px] min-h-[200px] flex flex-col justify-between gap-6 text-white shadow-[0_30px_60px_-28px_rgba(11,23,38,0.6)]" style="background-color:#07111F;background-image:radial-gradient(80% 90% at 100% 0%, rgba(34,199,214,0.45) 0%, rgba(34,199,214,0) 60%), radial-gradient(70% 80% at 0% 100%, rgba(43,217,143,0.4) 0%, rgba(43,217,143,0) 60%)">
            <div class="flex justify-between items-start"><span class="mono text-[28px] text-[#3A4A5E]">0{i + 1}</span><span class="w-[46px] h-[46px] rounded-full bg-teal grid place-items-center text-navy"><Icon name="check" size={20} stroke={2.4} /></span></div>
            <span class="font-semibold text-lg">{v.t}</span>
            <span class="text-sm leading-relaxed text-[#B9C4D0]">{v.s}</span>
          </div>
        ) : (
          <div class="relative rounded-[24px] bg-soft p-[26px] min-h-[200px] flex flex-col justify-between gap-6">
            <span class="font-semibold text-lg">{v.t}</span>
            <span class="text-sm leading-relaxed text-body pr-10">{v.s}</span>
            <span class="absolute right-[22px] bottom-[18px] mono text-[28px] text-[#D3DBD6]">0{i + 1}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SEO BUILT IN -->
  <section class="grid-tint section px-5 sm:px-6">
    <div class="max-w-[1240px] mx-auto grid gap-16 lg:grid-cols-2 items-center">
      <div class="relative min-h-[440px]">
        <div class="absolute left-[10%] top-0 w-[62%] h-[420px] rounded-[30px] overflow-hidden bg-navy shadow-[0_40px_80px_-30px_rgba(7,17,31,0.5)]">
          <img src="/images/anil.webp" alt="Anil Jaishi at Pixova" width="800" height="800" loading="lazy" class="absolute inset-0 w-full h-full object-cover object-[50%_25%]" />
          <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(7,17,31,0) 50%, rgba(7,17,31,0.75) 100%), linear-gradient(135deg, rgba(43,217,143,0.2) 0%, rgba(34,199,214,0) 55%)"></div>
        </div>
        <div class="absolute left-0 top-10 flex items-center gap-2.5 py-2.5 pl-2.5 pr-4 rounded-full bg-white shadow-[0_18px_40px_-16px_rgba(11,23,38,0.3)]"><span class="w-9 h-9 rounded-full bg-teal grid place-items-center font-bold text-sm">7</span><span class="text-[13px] leading-tight">Days to<br />go live</span></div>
        <div class="absolute right-0 bottom-10 w-[48%] sm:w-[44%] rounded-[24px] bg-navy text-white p-5 flex flex-col gap-3 shadow-[0_30px_60px_-24px_rgba(11,23,38,0.5)]">
          <span class="text-[13px] text-[#A9B6C4]">Rankings, built monthly</span>
          <div class="flex items-end gap-1.5 h-20">{[25, 40, 35, 60, 75, 100].map((h, i) => <span class="flex-1 rounded-md" style={`height:${h}%;background:${i === 5 ? '#fff' : '#2BD98F'}`}></span>)}</div>
        </div>
      </div>
      <div class="flex flex-col gap-6">
        <Eyebrow icon="search" white>Built for Google</Eyebrow>
        <h2 class="h2">SEO Built In From The First Line Of Code.</h2>
        <p class="text-base leading-relaxed text-body max-w-[500px]">Pages, headings and images are designed for search from day one. Never bolted on at the end, never sold as a mystery extra. Local SEO usually shows steady results within 3 to 6 months, and you'll see every step in a report written for humans.</p>
        <Button href="/services/" variant="dark" class="self-start">See my services</Button>
      </div>
    </div>
  </section>

  <!-- PROMISES -->
  <section class="section px-5 sm:px-6">
    <div class="max-w-[1240px] mx-auto flex flex-col gap-12">
      <div class="flex flex-wrap justify-between items-end gap-6">
        <div class="flex flex-col gap-5">
          <Eyebrow icon="shield">What I stand for</Eyebrow>
          <h2 class="h2 max-w-[640px]">Practical Promises. Kept Every Month.</h2>
        </div>
        <p class="max-w-[380px] text-[15px] leading-relaxed text-body">Six things every Pixova client gets, whichever plan they're on.</p>
      </div>
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {promises.map((p, i) => (
          <div class={`rounded-[24px] p-[26px] flex flex-col gap-3.5 ${p.dark ? 'bg-navy text-white' : 'border border-line'}`}>
            <div class="flex justify-between items-center"><span class="mono text-xs text-[#8E9BAA]">0{i + 1}</span><span class={`w-9 h-9 rounded-[10px] grid place-items-center ${p.dark ? 'bg-teal text-navy' : 'bg-mint text-teal-dark'}`}><Icon name={p.icon} size={16} /></span></div>
            <span class="font-semibold text-lg">{p.t}</span>
            <span class={`text-sm leading-relaxed ${p.dark ? 'text-[#B9C4D0]' : 'text-body'}`}>{p.s}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO YOU'LL WORK WITH -->
  <section class="art section px-5 sm:px-6">
    <img src="/images/art/aurora-dark.jpg" alt="" loading="lazy" class="art-bg opacity-60" />
    <div class="art-shade" style="background:linear-gradient(180deg, rgba(7,17,31,0.3) 0%, rgba(7,17,31,0.92) 70%)"></div>
    <div class="art-body max-w-[1240px] mx-auto grid gap-12 lg:grid-cols-[0.9fr_1.1fr] items-center">
      <div class="relative">
        <div class="relative h-[460px] sm:h-[540px] rounded-[32px] overflow-hidden bg-navy-2 shadow-[0_50px_90px_-40px_rgba(0,0,0,0.7)]">
          <img src="/images/anil.webp" alt="Anil Jaishi, founder of Pixova" width="800" height="800" loading="lazy" class="absolute inset-0 w-full h-full object-cover object-[50%_25%]" />
          <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(7,17,31,0) 55%, rgba(7,17,31,0.9) 100%)"></div>
          <div class="absolute left-6 right-6 bottom-6 flex flex-wrap items-end justify-between gap-4">
            <span class="flex flex-col"><span class="font-semibold text-2xl tracking-[-0.03em]">Anil Jaishi</span><span class="text-sm text-[#C8D3DD]">Founder &amp; Director, Pixova</span></span>
            <a href={SITE.whatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-2 min-h-11 px-4 rounded-full bg-teal text-navy text-sm font-semibold"><Icon name="whatsapp" size={16} />Message me</a>
          </div>
        </div>
        <div class="px-float hidden sm:flex absolute -right-4 top-10 items-center gap-2.5 py-2.5 pl-2.5 pr-4 rounded-full bg-white text-navy shadow-[0_18px_40px_-16px_rgba(0,0,0,0.5)]"><span class="w-9 h-9 rounded-full grid place-items-center" style="background:var(--grad)"><Icon name="clock" size={16} /></span><span class="text-[13px] leading-tight font-medium">Replies within<br />one working day</span></div>
      </div>

      <div class="flex flex-col gap-7">
        <Eyebrow icon="user" dark>Who you'll work with</Eyebrow>
        <h2 class="h2 !text-white">The Person Who Builds It Answers The Phone.</h2>
        <div class="flex flex-col gap-4 text-base leading-relaxed text-[#C8D3DD] max-w-[560px]">
          <p>Pixova is me. No account managers, no hand-offs, no ticket numbers. When you message about your website, the person reading it is the person who built it.</p>
          <p>I use AI tools to build faster, which is why most sites go live in about a week and cost a fraction of an agency quote. Then I go through every page by hand before anyone sees it.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="glass rounded-[20px] p-5 flex flex-col gap-1"><span class="font-medium text-[28px] tracking-[-0.04em] text-teal">B'ham</span><span class="text-[13px] text-[#A9B6C4]">Based in Birmingham, working UK-wide</span></div>
          <div class="glass rounded-[20px] p-5 flex flex-col gap-1"><span class="font-medium text-[28px] tracking-[-0.04em] text-teal">~7 days</span><span class="text-[13px] text-[#A9B6C4]">From first call to live site</span></div>
          <div class="glass rounded-[20px] p-5 flex flex-col gap-1"><span class="font-medium text-[28px] tracking-[-0.04em] text-teal">1</span><span class="text-[13px] text-[#A9B6C4]">Person to deal with, start to finish</span></div>
        </div>
        <div class="glass rounded-[24px] p-6 flex flex-col gap-4">
          <span class="text-sm font-semibold">Checked by hand before every launch</span>
          <div class="flex flex-wrap gap-2">
            {['Every page on a real phone', 'Forms send to your inbox', 'Copy read line by line', 'Load speed on 4G', 'Google can see every page'].map(t => (
              <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/10 border border-white/10 text-[13px] text-[#DCE3EA]"><span class="text-teal"><Icon name="check" size={14} stroke={2.8} /></span>{t}</span>
            ))}
          </div>
          <span class="text-[13px] text-[#A9B6C4]">University of Birmingham · Digital Marketing</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STRIP -->
  <section class="px-5 sm:px-6 py-14">
    <div class="max-w-[1240px] mx-auto flex flex-col items-center gap-6">
      <span class="text-sm text-muted">Building for local businesses across the UK</span>
      <div class="flex flex-wrap justify-center gap-x-10 gap-y-4 font-semibold text-[clamp(18px,2vw,22px)] tracking-[-0.03em] text-body">
        {['Plumbers', 'Electricians', 'Builders', 'Salons', 'Cafés', 'Therapists', 'Accountants', 'Solicitors'].map(t => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="art section px-5 sm:px-6">
    <img src="/images/art/ribbons-dark.jpg" alt="" loading="lazy" class="absolute left-0 right-0 top-0 w-full h-[60%] object-cover opacity-45" />
    <div class="art-shade" style="background:linear-gradient(180deg, rgba(7,17,31,0.35) 0%, #07111F 55%)"></div>
    <div class="art-body max-w-[1240px] mx-auto flex flex-col items-center gap-12">
      <div class="flex flex-col items-center gap-5 text-center">
        <Eyebrow icon="star" dark>Client feedback</Eyebrow>
        <h2 class="h2 !text-white max-w-[760px]">Don't Take My Word For It.</h2>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section px-5 sm:px-6 wash scroll-mt-24">
    <div class="max-w-[1240px] mx-auto grid gap-12 lg:grid-cols-[1fr_1.2fr] items-start">
      <div class="flex flex-col gap-6">
        <Eyebrow icon="chat" white>Get in touch</Eyebrow>
        <h2 class="h2">Let's Have A Chat.</h2>
        <p class="lead max-w-[460px]">Tell me a bit about your business. I'll reply within one working day with what I'd do and what it would cost.</p>
        <div class="grid gap-3 sm:grid-cols-2 max-w-[460px]">
          <a href={SITE.whatsapp} target="_blank" rel="noopener" class="flex flex-col gap-4 p-[22px] rounded-[24px] text-white" style="background-color:#07111F;background-image:radial-gradient(90% 90% at 100% 0%, rgba(34,199,214,0.5) 0%, rgba(34,199,214,0) 60%), radial-gradient(80% 80% at 0% 100%, rgba(43,217,143,0.45) 0%, rgba(43,217,143,0) 60%)"><span class="w-10 h-10 rounded-full bg-teal grid place-items-center text-navy"><Icon name="whatsapp" size={18} /></span><span class="flex flex-col"><span class="font-semibold">WhatsApp</span><span class="text-[13px] text-[#A9B6C4]">{SITE.phone}</span></span></a>
          <a href={`mailto:${SITE.email}`} class="flex flex-col gap-4 p-[22px] rounded-[24px] bg-white text-navy border border-line"><span class="w-10 h-10 rounded-full bg-mint grid place-items-center text-teal-dark"><Icon name="mail" size={18} /></span><span class="flex flex-col"><span class="font-semibold">Email</span><span class="text-[13px] text-body">{SITE.email}</span></span></a>
        </div>
      </div>
      <EnquiryForm id="about-enquiry" />
    </div>
  </section>
</Layout>
