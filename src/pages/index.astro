<script>
  // Count-up animation for live stats
  const counters = document.querySelectorAll<HTMLElement>('.live-counter');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      const target = parseInt(el.dataset.target || '0');
      const delay = parseInt(el.dataset.delay || '0');
      const duration = 1200;
      const start = performance.now();
      setTimeout(() => {
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const ease = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(ease * target));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, delay);
      obs.unobserve(el);
    });
  }, { threshold: 0.5 });
  counters.forEach(c => obs.observe(c));

  // ── Exit intent modal ──────────────────────────────────
  const modal      = document.getElementById('exit-modal')!;
  const panel      = document.getElementById('exit-modal-panel')!;
  const closeBtn   = document.getElementById('exit-modal-close')!;
  const dismissBtn = document.getElementById('exit-modal-dismiss')!;
  const exitForm   = document.getElementById('exit-form') as HTMLFormElement;
  const exitSuccess = document.getElementById('exit-form-success')!;
  const exitBtn    = document.getElementById('exit-form-btn') as HTMLButtonElement;

  const SESSION_KEY = 'px_exit_shown';
  let readyToShow = false;
  let lastScrollY = window.scrollY;

  const isPreview = new URLSearchParams(window.location.search).has('preview_popup');
  if (isPreview) sessionStorage.removeItem(SESSION_KEY);

  if (!sessionStorage.getItem(SESSION_KEY)) {
    setTimeout(() => { readyToShow = true; }, isPreview ? 0 : 5000);
  }

  const typingEl   = document.getElementById('chat-typing')!;
  const messageEl  = document.getElementById('chat-message')!;
  const stampEl    = document.getElementById('chat-timestamp')!;

  function showModal() {
    if (!readyToShow || sessionStorage.getItem(SESSION_KEY)) return;
    sessionStorage.setItem(SESSION_KEY, '1');

    // Reset chat state
    typingEl.style.display  = 'none';
    messageEl.style.display = 'none';
    stampEl.style.display   = 'none';

    modal.style.display = 'flex';
    panel.style.opacity = '0';
    panel.style.transform = window.innerWidth < 640 ? 'translateY(100%)' : 'translateY(20px)';
    panel.style.transition = 'transform 0.38s cubic-bezier(0.22,1,0.36,1), opacity 0.3s ease';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      panel.style.opacity = '1';
      panel.style.transform = 'translateY(0)';
    }));

    // Typing indicator appears after panel slides in
    setTimeout(() => {
      typingEl.style.display = 'inline-flex';
    }, 500);

    // Swap typing → message after 2s of "typing"
    setTimeout(() => {
      typingEl.style.display  = 'none';
      messageEl.style.display = 'inline-block';
      messageEl.style.opacity = '0';
      messageEl.style.transform = 'translateY(5px)';
      messageEl.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      requestAnimationFrame(() => requestAnimationFrame(() => {
        messageEl.style.opacity   = '1';
        messageEl.style.transform = 'translateY(0)';
      }));
      setTimeout(() => { stampEl.style.display = 'block'; }, 320);
    }, 2500);
  }

  function hideModal() {
    panel.style.opacity = '0';
    panel.style.transform = window.innerWidth < 640 ? 'translateY(100%)' : 'translateY(20px)';
    setTimeout(() => { modal.style.display = 'none'; }, 350);
  }

  // Desktop: cursor leaves document toward the top (back/close button area)
  document.addEventListener('mouseout', (e) => {
    if (!e.relatedTarget && (e as MouseEvent).clientY < 10) showModal();
  });

  // Mobile: fast scroll upward (backing out behaviour)
  window.addEventListener('scroll', () => {
    const delta = lastScrollY - window.scrollY;
    if (delta > 50 && window.scrollY > 200) showModal();
    lastScrollY = window.scrollY;
  }, { passive: true });

  // Mobile: switching tabs or pressing home
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') showModal();
  });

  closeBtn.addEventListener('click', hideModal);
  dismissBtn.addEventListener('click', hideModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

  // Form submit
  exitForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    exitBtn.disabled = true;
    exitBtn.textContent = 'Sending…';
    try {
      const res = await fetch(exitForm.action, {
        method: 'POST',
        body: new FormData(exitForm),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        exitForm.classList.add('hidden');
        exitSuccess.classList.remove('hidden');
        setTimeout(hideModal, 3000);
      } else {
        exitBtn.disabled = false;
        exitBtn.textContent = 'Get in touch →';
      }
    } catch {
      exitBtn.disabled = false;
      exitBtn.textContent = 'Claim my free website';
    }
  });

  // ── Urgency bar dismiss ─────────────────────────────
  const urgencyBar  = document.getElementById('urgency-bar');
  const urgencyClose = document.getElementById('urgency-close');
  if (urgencyBar) {
    if (sessionStorage.getItem('px_urgency')) {
      urgencyBar.style.display = 'none';
    } else if (urgencyClose) {
      urgencyClose.addEventListener('click', () => {
        urgencyBar.style.maxHeight = '0';
        urgencyBar.style.opacity   = '0';
        sessionStorage.setItem('px_urgency', '1');
        setTimeout(() => { urgencyBar.style.display = 'none'; }, 420);
      });
    }
  }

  // ── Magnetic buttons (desktop pointer only) ─────────
  if (window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.btn-p, .btn-g').forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        btn.style.transition = 'background-color 0.15s, border-color 0.15s';
      });
      btn.addEventListener('mousemove', (e) => {
        const r  = btn.getBoundingClientRect();
        const mx = e.clientX - r.left  - r.width  / 2;
        const my = e.clientY - r.top   - r.height / 2;
        btn.style.transform = `translate(${mx * 0.13}px, ${my * 0.18}px)`;
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.transition = 'background-color 0.15s, border-color 0.15s, transform 0.45s cubic-bezier(0.22,1,0.36,1)';
        btn.style.transform  = 'translate(0,0)';
        setTimeout(() => { btn.style.transition = ''; }, 450);
      });
    });
  }
</script>


  <script>
    (function() {
      function initCarousels() {
        document.querySelectorAll('.swipe-wrap').forEach(wrap => {
          const grid = wrap.querySelector('.swipe-grid, .pricing-wrap');
          const dotsEl = wrap.querySelector('.swipe-dots');
          if (!grid || !dotsEl) return;
          dotsEl.innerHTML = '';
          const items = Array.from(grid.children).filter(el => !el.classList.contains('p-popular-badge'));
          if (items.length < 2) return;
          const dots = items.map((_, i) => {
            const btn = document.createElement('button');
            btn.className = 'swipe-dot' + (i === 0 ? ' is-active' : '');
            btn.setAttribute('aria-label', 'Item ' + (i + 1));
            btn.onclick = () => items[i].scrollIntoView({behavior:'smooth',block:'nearest',inline:'start'});
            dotsEl.appendChild(btn);
            return btn;
          });
          const obs = new IntersectionObserver(entries => {
            entries.forEach(e => {
              if (e.isIntersecting && e.intersectionRatio >= 0.5) {
                const idx = items.indexOf(e.target);
                if (idx >= 0) dots.forEach((d,i) => d.classList.toggle('is-active', i === idx));
              }
            });
          }, {root: grid, threshold: 0.5});
          items.forEach(item => obs.observe(item));
        });
      }
      initCarousels();
    })();
  </script>
