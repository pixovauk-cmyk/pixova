---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import CtaBand from '../components/CtaBand.astro';
import SoftwareMock from '../components/SoftwareMock.astro';
import LaunchWeek from '../components/LaunchWeek.astro';
import { TOOLS } from '../data/software';
import { PLANS, SOFTWARE_FROM, SITE } from '../data/site';
import { getCollection } from 'astro:content';

const fromPrice = Math.min(...PLANS.map(p => p.six));
const tools = TOOLS.slice(0, 4);
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const postArt = ['/images/art/orb-dark.jpg', '/images/art/ribbons-dark.jpg', '/images/art/rings-light.jpg'];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const topicOf = (id: string) => id.includes('local') ? 'Local SEO' : id.includes('seo') ? 'SEO' : id.includes('automation') ? 'Automation' : 'Web design';

const services = [
  {
    title: 'Websites',
    desc: "Mobile-first, fast and set up for Google from the first line of code. I write the words, build it, host it and keep it updated. Live in about 7 days, and it's yours.",
    href: '/web-design/', art: '/images/art/ribbons-dark.jpg',
  },
  {
    title: 'Local SEO',
    desc: "Google Business Profile done properly, a page for every service and area, a blog post every month and a ranking report you can read in two minutes.",
    href: '/local-seo/', art: '/images/art/grid-dark.jpg',
  },
  {
    title: 'Custom Software',
    desc: `Quote calculators, bookings with deposits, job sheets, invoices. One small tool that kills the job you hate, for a fixed price from £${SOFTWARE_FROM}.`,
    href: '/custom-software/', art: '/images/art/glass-dark.jpg',
  },
  {
    title: 'AI & Automation',
    desc: 'Enquiries answered in minutes, leads followed up automatically and a review request after every job. Works with any website, not just ones I built.',
    href: '/services/#automation', art: '/images/art/orb-dark.jpg',
  },
  {
    title: 'CRM & Email',
    desc: 'Every lead in one place, a nudge when someone goes quiet, and a short email sequence that turns “maybe later” into a booking.',
    href: '/pricing/#add-ons', art: '/images/art/aurora-dark.jpg',
  },
];

const faq = [
  { q: 'How much does a small business website cost?', a: `Plans start at £${fromPrice} a month on a 6-month term, plus a one-off setup fee from £199. That covers the build, hosting, SSL, backups and monthly changes. No VAT is added because Pixova isn't VAT registered.` },
  { q: 'When do I pay?', a: "The setup fee and your first month are taken when you sign up through checkout. After that it's monthly. If you'd rather talk first, send an enquiry and I'll send you a payment link once you're happy." },
  { q: 'How fast can you build it?', a: 'Most websites go live within 7 days of our first call. Small custom tools usually take about a week too. Bigger jobs get a clear date before you pay anything.' },
  { q: 'What does custom software cost?', a: `Small tools start at £${SOFTWARE_FROM}, one-off. You get a fixed price before I start, so there are no surprise bills. Hosting for the tool can be added if you need it.` },
  { q: 'Do I need to know anything technical?', a: 'No. You tell me how your business works, I build it, and I show you how to use it. If something needs changing, you message me.' },
  { q: 'Do you only work with Birmingham businesses?', a: "I'm based in Birmingham, but I work with small businesses all over the UK. Everything is done over the phone, WhatsApp and video calls." },
  { q: 'How long until I show up on Google?', a: 'Your site is set up so Google can find it from day one. Ranking well for busy local searches usually takes 3 to 6 months of steady work, which is what the Get Found and Get Leads plans are for.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title="Small Business Websites & Custom Software | Pixova, Birmingham"
  description={`Websites, local SEO and simple custom software for UK small businesses. Live in 7 days. Websites from £${fromPrice}/month, custom tools from £${SOFTWARE_FROM}. Based in Birmingham.`}
  canonicalUrl="https://www.pixova.uk/"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <section class="px-5 sm:px-6 pt-6 sm:pt-10 pb-16 overflow-x-clip">
    <div class="max-w-[1240px] mx-auto grid gap-10 lg:gap-14 lg:grid-cols-[1.05fr_1fr] items-center">
      <div class="relative z-10 flex flex-col gap-7 min-w-0">
        <span class="pill-badge"><span class="dot"><Icon name="bolt" size={13} stroke={2.4} /></span>Live in 7 days, not 7 weeks</span>
        <h1 class="font-medium text-[clamp(44px,5.4vw,84px)] leading-[0.97] tracking-[-0.055em]">Websites That Make Your Phone <span class="grad-text">Ring.</span></h1>
        <p class="text-[17px] leading-relaxed text-body max-w-[480px]">I design, write, build and look after websites for small businesses across the UK, then get them found on Google. You get on with the job. I make sure the calls keep coming.</p>
        <div class="flex flex-wrap gap-3">
          <Button href="/contact/">Get a fixed quote</Button>
          <Button href="#process" variant="light" icon="play">How it works</Button>
        </div>

        <form id="gap-quick" action="/gap-report/" class="flex flex-wrap gap-2 p-1.5 rounded-full bg-white/85 border border-[rgba(7,17,31,0.07)] max-w-[480px] shadow-[0_18px_40px_-24px_rgba(7,17,31,0.3)]">
          <label for="gap-url" class="sr-only">Your website</label>
          <input id="gap-url" name="website" inputmode="url" placeholder="yourwebsite.co.uk" class="flex-1 basis-[160px] min-w-0 min-h-11 px-4 bg-transparent text-[15px] focus:outline-none" />
          <button type="submit" class="btn btn-dark btn-sm">Free Gap Report</button>
        </form>
        <p class="-mt-4 text-[13px] muted">See who's beating you on Google, and why. 60 seconds, no card.</p>

        <div class="flex items-center gap-3.5">
          <div class="flex">
            {['/images/jake-victorsquare.webp', '/images/Ayoushsqaure.webp', '/images/feldon-haynes.webp'].map((src, i) => (
              <img src={src} alt="" width="40" height="40" class={`w-10 h-10 rounded-full object-cover object-top border-[3px] border-white ${i ? '-ml-3' : ''}`} />
            ))}
          </div>
          <span class="text-sm leading-snug text-body"><span class="text-[#F5B841] tracking-widest">★★★★★</span><br />Trusted by trades, founders &amp; local firms</span>
        </div>
      </div>

      <div role="img" aria-label="Anil Jaishi, founder of Pixova, with cards showing fully managed hosting, a 7-day launch and same-day replies" class="relative mx-auto w-full max-w-[580px] h-[440px] sm:h-[560px]">
        <!-- Supporting graphics: kept inside this box, behind Anil -->
        <div aria-hidden="true" class="absolute inset-0 overflow-hidden rounded-b-[40px] pointer-events-none">
          <div class="hero-blob absolute left-1/2 top-[54%] w-[68%] max-w-[380px] aspect-square rounded-full opacity-90" style="background:radial-gradient(circle at 35% 30%, #A8F5D3 0%, #2BD98F 45%, #22C7D6 100%)"></div>
          <div class="hero-spin absolute left-1/2 top-[54%] w-[84%] max-w-[470px] aspect-square rounded-full border border-dashed border-[#9ED9C4]" style="translate:-50% -50%">
            <span class="absolute left-1/2 -top-[6px] w-3 h-3 -ml-[6px] rounded-full bg-teal shadow-[0_0_0_6px_rgba(43,217,143,0.18)]"></span>
            <span class="absolute -right-[4px] top-1/2 w-2 h-2 rounded-full bg-aqua"></span>
          </div>
          <div class="hero-spin-rev absolute left-1/2 top-[54%] w-[100%] max-w-[560px] aspect-square rounded-full border border-[#D5ECE2]" style="translate:-50% -50%">
            <span class="absolute left-[15%] top-[15%] w-2 h-2 rounded-full bg-navy/60"></span>
          </div>
          <svg class="absolute right-[4%] top-[4%] w-14 h-14 text-teal/50" viewBox="0 0 64 64" fill="currentColor">{[0,1,2,3,4].flatMap(r => [0,1,2,3,4].map(c => <circle cx={6 + c * 13} cy={6 + r * 13} r="2" />))}</svg>
        </div>

        <img src="/images/anil-cutout-680.png" alt="" width="680" height="680" fetchpriority="high" class="hero-person absolute left-1/2 -translate-x-1/2 bottom-0 w-[86%] max-w-[500px] h-auto z-[1]" />

        <!-- Floating cards -->
        <div class="px-float absolute left-0 top-[14%] w-[150px] sm:w-[184px] rounded-[22px] bg-white/90 backdrop-blur-md border border-[rgba(7,17,31,0.06)] p-4 sm:p-5 flex flex-col gap-2 shadow-[0_30px_60px_-24px_rgba(7,17,31,0.35)] z-[2]">
          <span class="font-medium text-[34px] sm:text-[42px] tracking-[-0.05em] leading-none">100<span class="text-[18px] sm:text-[22px] text-teal-dark">%</span></span>
          <span class="text-[11px] sm:text-xs leading-normal text-body">Fully managed. Hosting, updates and security handled.</span>
          <div class="flex items-end gap-1.5 h-8 sm:h-10 mt-1">
            {[40, 68, 52, 86, 62, 100].map((h, i) => <span class="flex-1 rounded-full" style={`height:${h}%;background:${i === 5 ? '#07111F' : 'linear-gradient(180deg,#2BD98F,#22C7D6)'}`}></span>)}
          </div>
        </div>
        <div class="px-float2 absolute right-0 top-[10%] hidden sm:flex items-center gap-2.5 py-2 pl-2 pr-4 rounded-full bg-white shadow-[0_18px_40px_-16px_rgba(7,17,31,0.35)] z-[2]">
          <span class="w-9 h-9 rounded-full bg-navy text-teal grid place-items-center"><Icon name="clock" size={16} /></span>
          <span class="text-[13px] font-semibold leading-tight">Replies same day<br /><span class="font-normal text-muted">usually within minutes</span></span>
        </div>
        <div class="px-float2 absolute right-0 bottom-[16%] flex items-center gap-3 py-2.5 pl-2.5 pr-5 rounded-[20px] bg-navy text-white shadow-[0_24px_50px_-20px_rgba(7,17,31,0.5)] z-[2]">
          <span class="w-10 h-10 rounded-full grid place-items-center text-navy" style="background:var(--grad)"><Icon name="check" size={18} stroke={2.6} /></span>
          <span class="font-medium text-[17px] leading-tight tracking-[-0.03em]">Live in<br />7 days</span>
        </div>
        <span class="absolute left-1/2 -translate-x-1/2 bottom-3 z-[2] inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/90 backdrop-blur text-[13px] shadow-[0_12px_30px_-14px_rgba(7,17,31,0.4)] whitespace-nowrap"><strong>Anil Jaishi</strong><span class="text-muted hidden sm:inline">· Founder, builds every site</span><span class="text-muted sm:hidden">· Founder</span></span>
      </div>
    </div>
  </section>

  <!-- INDUSTRY STRIP -->
  <section aria-label="Who I build for" class="px-5 sm:px-6 pb-14">
    <div class="max-w-[1240px] mx-auto flex flex-wrap justify-center lg:justify-between items-center gap-x-8 gap-y-5 text-body/85 font-semibold text-[clamp(17px,1.8vw,22px)] tracking-[-0.03em]">
      {[['wrench', 'Plumbers'], ['bolt', 'Electricians'], ['scissors', 'Salons'], ['leaf', 'Landscapers'], ['cup', 'Cafés'], ['doc', 'Accountants'], ['scale', 'Solicitors']].map(([ic, t]) => (
        <span class="inline-flex items-center gap-2.5"><Icon name={ic} size={22} stroke={2} />{t}</span>
      ))}
    </div>
  </section>

  <!-- BETTER AGENCY -->
  <section class="grid-tint section px-5 sm:px-6">
    <div class="max-w-[1240px] mx-auto grid gap-16 lg:grid-cols-2 items-center">
      <div role="img" aria-label="Abstract artwork with a 7-days card and a fully managed card" class="relative min-h-[420px] sm:min-h-[460px] order-2 lg:order-1">
        <div class="absolute left-0 top-0 w-[58%] h-[420px] sm:h-[460px] rounded-[32px] overflow-hidden bg-navy">
          <img src="/images/art/ribbons-dark.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(7,17,31,0.1) 0%, rgba(7,17,31,0.55) 100%)"></div>
        </div>
        <div class="absolute right-0 top-[30px] w-[38%] h-40 rounded-[26px] overflow-hidden bg-navy"><img src="/images/art/glass-dark.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="px-float absolute left-[34%] top-[120px] w-[176px] rounded-[26px] p-[22px] flex flex-col gap-0.5 shadow-[0_30px_60px_-20px_rgba(34,199,214,0.7)] z-[2]" style="background:linear-gradient(145deg,#2BD98F 0%,#22C7D6 100%)"><span class="font-medium text-[58px] tracking-[-0.05em] leading-none">7</span><span class="text-[21px] font-medium tracking-[-0.03em]">Days</span><span class="text-xs text-[#073B2B] mt-1.5">first chat to live site</span></div>
        <div class="px-float2 absolute right-[2%] top-[250px] w-[50%] sm:w-[46%] rounded-[24px] bg-white/95 p-5 flex items-center gap-3.5 shadow-[0_24px_50px_-20px_rgba(7,17,31,0.3)] z-[2]"><span class="flex-none w-[50px] h-[50px] rounded-[15px] bg-navy grid place-items-center text-teal"><Icon name="shieldcheck" size={22} stroke={2} /></span><span class="font-medium text-[21px] leading-[1.08] tracking-[-0.035em]">Fully<br />Managed</span></div>
      </div>
      <div class="flex flex-col gap-6 order-1 lg:order-2">
        <Eyebrow icon="clock" white>Built in Birmingham · trusted UK-wide</Eyebrow>
        <h2 class="h2">A Better Agency For <span class="grad-text">Small Business.</span></h2>
        <div class="flex flex-col gap-4 max-w-[520px] text-base leading-relaxed text-body">
          <p>Right now, someone near you is searching for exactly what you do. If your website is slow, out of date or missing, they ring the next name on the list, and you never even hear about it.</p>
          <p>Agencies charge thousands for sites that look nice and never rank. I build fast, SEO-ready sites with AI, check every one by hand, then look after it every month for one fair price.</p>
          <p class="text-navy font-semibold">Fix the website, show up on Google, and those calls come to you instead.</p>
        </div>
        <Button href="/about/" variant="dark" class="self-start">Read my story</Button>
      </div>
    </div>
  </section>

  <!-- RECENT WORK -->
  <section class="art section px-5 sm:px-6">
    <img src="/images/art/aurora-dark.jpg" alt="" loading="lazy" class="art-bg opacity-55" />
    <div class="art-shade" style="background:linear-gradient(180deg, rgba(7,17,31,0.3) 0%, rgba(7,17,31,0.92) 70%)"></div>
    <div class="art-body max-w-[1240px] mx-auto flex flex-col gap-12">
      <div class="flex flex-wrap justify-between items-end gap-6">
        <div class="flex flex-col gap-5">
          <Eyebrow icon="monitor" dark>Recent launches</Eyebrow>
          <h2 class="h2 !text-white">Take A Look At<br />My Recent Work</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/designs/" variant="ghost" icon="none">Browse 20+ designs</Button>
          <Button href="/contact/">Start a project</Button>
        </div>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="flex flex-col gap-4 reveal">
          <div aria-hidden="true" class="relative h-[380px] rounded-[28px] overflow-hidden px-7 pt-7 flex items-end bg-[#0B1E33]">
            <img src="/images/art/grid-dark.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            <div class="relative w-full h-[290px] rounded-t-2xl bg-white overflow-hidden flex flex-col text-navy shadow-[0_-20px_60px_-20px_rgba(43,217,143,0.6)]">
              <div class="h-[26px] bg-[#EEF1EE] flex items-center gap-[5px] px-2.5"><span class="w-[7px] h-[7px] rounded-full bg-[#F87171]"></span><span class="w-[7px] h-[7px] rounded-full bg-[#FBBF24]"></span><span class="w-[7px] h-[7px] rounded-full bg-[#34D399]"></span></div>
              <div class="p-[18px] flex flex-col gap-2.5">
                <div class="flex justify-between"><span class="w-[54px] h-2 rounded bg-navy"></span><span class="w-[90px] h-2 rounded bg-[#DCE3E0]"></span></div>
                <span class="mt-3.5 font-semibold text-[22px] tracking-[-0.04em] leading-[1.05]">Design That<br />Gets You Noticed</span>
                <span class="w-[70%] h-[7px] rounded bg-[#DCE3E0]"></span>
                <span class="w-[90px] h-[26px] rounded-full" style="background:var(--grad)"></span>
              </div>
            </div>
          </div>
          <div class="flex gap-4 text-[13px] text-[#A9B6C4]"><span>● Website design</span><span>● feldonhaynes.com</span></div>
          <h3 class="!text-white text-[26px] tracking-[-0.035em]">Feldon Haynes</h3>
        </article>
        <article class="flex flex-col gap-4 reveal">
          <div aria-hidden="true" class="relative h-[380px] rounded-[28px] overflow-hidden px-7 pt-7 flex items-end bg-[#0B1E33]">
            <img src="/images/art/glass-dark.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            <div class="relative w-full h-[290px] rounded-t-2xl bg-navy overflow-hidden flex flex-col text-white border border-white/10 border-b-0">
              <div class="h-[26px] bg-[#0E1C2E] flex items-center gap-[5px] px-2.5"><span class="w-[7px] h-[7px] rounded-full bg-[#F87171]"></span><span class="w-[7px] h-[7px] rounded-full bg-[#FBBF24]"></span><span class="w-[7px] h-[7px] rounded-full bg-[#34D399]"></span></div>
              <div class="p-[18px] flex flex-col gap-2.5">
                <div class="flex justify-between"><span class="w-[60px] h-2 rounded bg-teal"></span><span class="w-[90px] h-2 rounded bg-[#24364D]"></span></div>
                <span class="mt-3.5 font-semibold text-[22px] tracking-[-0.04em] leading-[1.05]">Smarter Systems<br />For Growing Teams</span>
                <span class="w-[70%] h-[7px] rounded bg-[#24364D]"></span>
                <div class="flex gap-2"><span class="flex-1 h-12 rounded-[10px] bg-navy-2"></span><span class="flex-1 h-12 rounded-[10px] bg-navy-2"></span><span class="flex-1 h-12 rounded-[10px] bg-navy-2"></span></div>
              </div>
            </div>
          </div>
          <div class="flex gap-4 text-[13px] text-[#A9B6C4]"><span>● Website &amp; SEO</span><span>● Founder: Ayoush</span></div>
          <h3 class="!text-white text-[26px] tracking-[-0.035em]">TranoVex</h3>
        </article>
        <article class="flex flex-col gap-4 reveal">
          <div aria-hidden="true" class="relative h-[380px] rounded-[28px] overflow-hidden px-7 pt-7 flex items-end bg-[#0B1E33]">
            <img src="/images/art/orb-dark.jpg" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
            <div class="relative w-full h-[290px] rounded-t-2xl bg-[#F6FBF8] overflow-hidden flex flex-col text-navy">
              <div class="h-[26px] bg-[#E6EEE9] flex items-center gap-[5px] px-2.5"><span class="w-[7px] h-[7px] rounded-full bg-[#F87171]"></span><span class="w-[7px] h-[7px] rounded-full bg-[#FBBF24]"></span><span class="w-[7px] h-[7px] rounded-full bg-[#34D399]"></span></div>
              <div class="p-[18px] flex flex-col gap-2.5">
                <div class="flex justify-between"><span class="w-[54px] h-2 rounded bg-navy"></span><span class="w-[78px] h-[22px] rounded-full bg-navy"></span></div>
                <span class="mt-2.5 font-semibold text-[22px] tracking-[-0.04em] leading-[1.05]">24/7 Local<br />Call-Outs</span>
                <div class="flex gap-2 items-center"><span class="w-24 h-7 rounded-full" style="background:var(--grad)"></span><span class="w-20 h-2 rounded bg-[#DCE3E0]"></span></div>
                <span class="h-[60px] rounded-xl" style="background:linear-gradient(135deg,#D7F6E8,#D6EEF8)"></span>
              </div>
            </div>
          </div>
          <div class="flex gap-4 text-[13px] text-[#A9B6C4]"><span>● Website &amp; SEO</span><span>● Birmingham</span></div>
          <h3 class="!text-white text-[26px] tracking-[-0.035em]">Jake Victor</h3>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICES ACCORDION -->
  <section class="section px-5 sm:px-6" style="background:radial-gradient(50% 60% at 100% 50%, #E3F6FB 0%, rgba(227,246,251,0) 70%), #fff">
    <div class="max-w-[1240px] mx-auto grid gap-x-20 gap-y-14 lg:grid-cols-2 items-start">
      <div class="flex flex-col gap-6 lg:sticky lg:top-28">
        <Eyebrow icon="trend">What I do</Eyebrow>
        <h2 class="h2">How I Take Your Business To Page One</h2>
        <p class="lead max-w-[440px]">One person for your website, your Google rankings and the small bits of software that turn visitors into booked jobs. No hand-offs, no account managers.</p>
        <Button href="/services/" class="self-start">View all services</Button>
      </div>
      <div class="acc">
        {services.map((s, i) => (
          <details name="home-svc" open={i === 0}>
            <summary>{s.title}</summary>
            <div class="acc-body flex flex-wrap gap-5 items-center">
              <div class="flex-[1_1_220px] flex flex-col gap-3">
                <p class="text-[15px] leading-relaxed text-body">{s.desc}</p>
                <a href={s.href} class="link-arrow text-sm">Find out more <Icon name="arrow" size={14} stroke={2.6} /></a>
              </div>
              <div aria-hidden="true" class="relative flex-[0_0_190px] h-[124px] rounded-[18px] overflow-hidden bg-navy">
                <img src={s.art} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute left-3.5 right-3.5 bottom-3 px-2.5 py-2 rounded-[10px] bg-white/90 flex flex-col gap-[5px]"><span class="h-1.5 w-[60%] rounded bg-navy"></span><span class="h-[5px] w-[85%] rounded bg-[#C9D6CF]"></span></div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- LAUNCH WEEK (playable) -->
  <section id="process" class="section px-5 sm:px-6 bg-tint overflow-hidden scroll-mt-20">
    <div class="max-w-[1240px] mx-auto flex flex-col gap-12">
      <div class="flex flex-wrap justify-between items-end gap-6">
        <div class="flex flex-col gap-5">
          <Eyebrow icon="calendar" white>Simple 5-day process</Eyebrow>
          <h2 class="h2">Monday We Talk.<br />Friday You're Live.</h2>
        </div>
        <p class="max-w-[380px] text-[15px] leading-relaxed text-body">No months of meetings. You give me 20 minutes, I do the rest. Watch a real week play out, or tap a day to jump to it.</p>
      </div>
      <LaunchWeek />
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="art section px-5 sm:px-6">
    <img src="/images/art/ribbons-dark.jpg" alt="" loading="lazy" class="absolute left-0 right-0 top-0 w-full h-[60%] object-cover opacity-45" />
    <div class="art-shade" style="background:linear-gradient(180deg, rgba(7,17,31,0.35) 0%, #07111F 55%)"></div>
    <div class="art-body max-w-[1240px] mx-auto flex flex-col items-center gap-12">
      <div class="flex flex-col items-center gap-5 text-center">
        <Eyebrow icon="star" dark>Client feedback</Eyebrow>
        <h2 class="h2 !text-white max-w-[760px]">Real People. Real Phones Ringing.</h2>
      </div>
      <div class="w-full grid gap-3.5 md:grid-cols-3">
        {[['Trades', 'Get found locally', 'rgba(43,217,143,0.16)', '#7EF0C0'], ['Salons & lifestyle', 'Beyond Instagram', 'rgba(34,199,214,0.16)', '#8CE6F0'], ['Professional firms', 'Build authority', 'rgba(96,165,250,0.18)', '#A9CCFB']].map(([t, s, bg, c]) => (
          <div class="glass rounded-[22px] p-[22px] flex justify-between items-center gap-3"><span class="font-semibold text-lg">{t}</span><span class="text-xs px-2.5 py-1.5 rounded-full" style={`background:${bg};color:${c}`}>{s}</span></div>
        ))}
      </div>
      <Testimonials />
      <Button href="/reviews/" variant="ghost" icon="none">Read all reviews</Button>
    </div>
  </section>

  <!-- CUSTOM SOFTWARE -->
  <section class="section px-5 sm:px-6">
    <div class="max-w-[1240px] mx-auto flex flex-col gap-12">
      <div class="flex flex-wrap justify-between items-end gap-6">
        <div class="flex flex-col gap-5 max-w-[680px]">
          <Eyebrow icon="code">Custom software from £{SOFTWARE_FROM}</Eyebrow>
          <h2 class="h2">Still Doing It On Paper, In WhatsApp, Or At 10pm?</h2>
        </div>
        <p class="max-w-[400px] text-[15px] leading-relaxed text-body">Most small businesses don't need expensive software. They need one small tool that does the annoying job for them. I build that, for a fixed price, usually in a week.</p>
      </div>
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
        {tools.map(t => (
          <article class="rounded-[26px] border border-line overflow-hidden bg-white reveal card-hover">
            <SoftwareMock kind={t.kind} />
            <div class="p-6 flex flex-col gap-2">
              <h3 class="text-[19px] font-semibold tracking-[-0.02em]">{t.name}</h3>
              <p class="text-sm leading-relaxed text-body">{t.fix}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="/custom-software/" variant="dark">See what I can build</Button>
        <Button href="/custom-software/#enquiry" variant="light">Tell me your idea</Button>
      </div>
    </div>
  </section>

  <!-- PRICING TEASER -->
  <section class="section px-5 sm:px-6 grid-tint">
    <div class="max-w-[1180px] mx-auto flex flex-col gap-12">
      <div class="flex flex-col items-center gap-5 text-center">
        <Eyebrow icon="target" white>Simple pricing</Eyebrow>
        <h2 class="h2 max-w-[720px]">One Monthly Price. Everything Handled.</h2>
        <p class="lead max-w-[560px]">Build, hosting, changes and support all included. Prices below are on the 3-month plan. Not VAT registered, so the price is the price.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3 items-center">
        {PLANS.map(p => (
          <article class={`flex flex-col gap-5 reveal ${p.featured ? 'rounded-[30px] px-[30px] py-[34px] shadow-[0_40px_80px_-30px_rgba(11,122,79,0.35)]' : 'rounded-[28px] p-[30px] bg-white border border-line'}`} style={p.featured ? 'border:2px solid transparent;background:linear-gradient(#fff,#fff) padding-box, linear-gradient(135deg,#2BD98F,#22C7D6) border-box' : ''}>
            <div class="flex flex-col gap-0.5"><span class={`text-sm ${p.featured ? 'text-teal-dark font-semibold' : 'text-muted'}`}>{p.featured ? 'Most popular' : p.slug === 'starter' ? 'Starter' : 'Pro'}</span><span class="font-semibold text-xl">{p.name}</span></div>
            <div class="flex items-baseline gap-1.5"><span class={`font-medium tracking-[-0.05em] ${p.featured ? 'text-[64px]' : 'text-[56px]'}`}>£{p.monthly}</span><span class="text-sm text-muted">/month</span></div>
            <span class="text-[13px] text-body -mt-2.5">+ £{p.setup} one-off setup</span>
            <ul class="tick-list text-sm text-body pt-[18px] border-t border-[#ECEFEC]">{p.features.slice(0, 4).map(f => <li>{f}</li>)}</ul>
            <a href={`/api/checkout/${p.slug}/?term=monthly`} rel="nofollow" class={`btn ${p.featured ? 'btn-grad' : 'btn-soft'}`}>Start with {p.name}</a>
          </article>
        ))}
      </div>
      <p class="text-center text-sm text-body">Need something bespoke? <a href="/pricing/#custom" class="link-arrow !inline">Custom software is priced per project from £{SOFTWARE_FROM}</a> · <a href="/pricing/" class="link-arrow !inline">Compare every plan</a></p>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="section px-5 sm:px-6">
    <div class="max-w-[1240px] mx-auto flex flex-col gap-14">
      <div class="flex flex-wrap justify-between items-end gap-6">
        <div class="flex flex-col gap-5 max-w-[620px]">
          <Eyebrow icon="book">Articles &amp; resources</Eyebrow>
          <h2 class="h2">Useful Reading</h2>
          <p class="text-base leading-relaxed text-body">Short guides from real client work. Five minutes each, no sign-up.</p>
        </div>
        <Button href="/blog/" variant="soft">All articles</Button>
      </div>

      {posts.length > 0 && (
        <div class="grid gap-x-14 gap-y-12 lg:grid-cols-[1.2fr_1fr] items-start">
          {(() => { const p = posts[0]; return (
            <a href={`/blog/${p.id}/`} class="group flex flex-col gap-6 text-navy reveal">
              <div class="relative aspect-[16/10] rounded-[32px] overflow-hidden bg-navy">
                <img src={p.data.heroImage ?? postArt[0]} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
                <span class="absolute left-5 top-5 px-3.5 py-2 rounded-full bg-white/92 text-xs font-semibold">Latest · {topicOf(p.id)}</span>
              </div>
              <div class="flex flex-col gap-3 max-w-[560px]">
                <span class="text-[13px] text-muted">{fmt(p.data.pubDate)}{p.data.readTime && ` · ${p.data.readTime}`}</span>
                <h3 class="text-[clamp(24px,2.4vw,32px)] leading-[1.12] tracking-[-0.035em] group-hover:text-teal-dark transition-colors">{p.data.title}</h3>
                <p class="text-[15px] leading-relaxed text-body line-clamp-2">{p.data.description}</p>
                <span class="link-arrow text-sm mt-1">Read article <Icon name="arrow" size={14} stroke={2.6} /></span>
              </div>
            </a>
          ); })()}

          <div class="flex flex-col">
            {posts.slice(1).map((p, i) => (
              <a href={`/blog/${p.id}/`} class={`group grid grid-cols-[120px_1fr] sm:grid-cols-[168px_1fr] gap-5 sm:gap-7 items-center py-8 text-navy reveal ${i ? 'border-t border-line' : 'lg:pt-0'}`}>
                <div class="relative aspect-square sm:aspect-[4/3.4] rounded-[22px] overflow-hidden bg-navy">
                  <img src={p.data.heroImage ?? postArt[(i + 1) % 3]} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.05]" />
                </div>
                <div class="flex flex-col gap-2.5 min-w-0">
                  <span class="text-xs font-semibold text-teal-dark">{topicOf(p.id)}{p.data.readTime && <span class="font-normal text-muted"> · {p.data.readTime}</span>}</span>
                  <h3 class="text-[19px] sm:text-[21px] leading-[1.2] tracking-[-0.03em] group-hover:text-teal-dark transition-colors">{p.data.title}</h3>
                  <span class="link-arrow text-sm">Read <Icon name="arrow" size={13} stroke={2.6} /></span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- FAQ + ENQUIRY -->
  <section class="section px-5 sm:px-6 wash">
    <div class="max-w-[1240px] mx-auto grid gap-12 lg:grid-cols-[1fr_1.15fr] items-start">
      <div class="flex flex-col gap-6">
        <Eyebrow icon="chat" white>Questions</Eyebrow>
        <h2 class="h2">Things People Ask Before They Ring.</h2>
        <p class="lead">Something else? <a href={SITE.whatsapp} target="_blank" rel="noopener" class="link-arrow !inline">WhatsApp me</a>. I reply to every message myself.</p>
        <div class="faq mt-2">
          {faq.map(f => (<details><summary>{f.q}</summary><div>{f.a}</div></details>))}
        </div>
      </div>
      <div class="lg:sticky lg:top-28">
        <EnquiryForm id="home-enquiry" heading="Get A Fixed Price" sub="Every enquiry comes straight to me. Reply within one working day, usually the same day." />
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  document.getElementById('gap-quick')?.addEventListener('submit', (e) => {
    e.preventDefault();
    let val = (document.getElementById('gap-url') as HTMLInputElement).value.trim();
    if (!val) { window.location.href = '/gap-report/'; return; }
    if (!/^https?:\/\//i.test(val)) val = 'https://' + val;
    window.location.href = '/gap-report/?website=' + encodeURIComponent(val);
  });

</script>
