---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Small Business Website Design | Pixova Birmingham"
  description="Pixova builds fast, SEO-ready websites for small businesses across the UK. Powered by AI, based in Birmingham. No jargon — just a site that gets you found."
  canonicalUrl="https://pixova.uk/"
>
  <link
    slot="head"
    rel="preload" as="image"
    href="/images/hero-anil.webp"
    fetchpriority="high"
  />

  <!-- HERO -->
  <section class="bg-offwhite pt-14 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: text -->
        <div class="order-2 lg:order-1 hero-animate">
          <span class="inline-block text-xs font-semibold tracking-widest uppercase mb-5" style="color:#2ECC9A;">
            Birmingham · AI-Powered · UK-Wide
          </span>
          <h1 class="font-heading font-semibold text-3xl sm:text-4xl lg:text-5xl leading-tight mb-5" style="color:#1C3557;">
            Small business website design.<br />We build it. You get found.<br /><span style="color:#2ECC9A;">Simple.</span>
          </h1>
          <p class="text-base sm:text-lg leading-relaxed mb-8 max-w-lg" style="color:#1A2E3D;">
            No confusing tech. No overpriced agencies. Just a proper
            small business website that actually brings in customers,
            built with AI and fully managed by us.
          </p>

          <div class="flex flex-wrap gap-3 mb-10">
            <a
              href="/about#contact"
              class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3.5 rounded-lg transition-colors min-h-[48px]"
              style="background-color:#2ECC9A; color:#fff;"
            >
              Let's have a chat
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3.5 rounded-lg border-2 transition-colors min-h-[48px]"
              style="border-color:#1C3557; color:#1C3557;"
            >
              See how it works
            </a>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-2 hero-animate-delay">
            {['UK-based team', 'Live in 7 days', 'Fully managed', 'No long contracts'].map(badge => (
              <span class="flex items-center gap-1.5 text-xs font-medium" style="color:#1A2E3D;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {badge}
              </span>
            ))}
          </div>
        </div>

        <!-- Right: image grid -->
        <div class="order-1 lg:order-2 hidden sm:grid grid-cols-2 gap-3 hero-animate-images">
          <div class="rounded-xl overflow-hidden" style="height:280px;">
            <img
              src="/images/hero-anil.webp"
              alt="Anil Jaishi, founder of Pixova Birmingham web design agency"
              width="800" height="446"
              loading="eager" fetchpriority="high"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="rounded-xl overflow-hidden" style="height:280px;">
            <img
              src="/images/hero-laptop.webp"
              alt="Pixova website shown on a laptop — small business web design Birmingham"
              width="800" height="1201"
              loading="eager"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="col-span-2 rounded-xl overflow-hidden" style="height:190px;">
            <img
              src="/images/hero-collage.webp"
              alt="Pixova team working on web design and SEO for small businesses"
              width="1400" height="781"
              loading="eager"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- WHO WE HELP -->
  <section class="py-20" style="background-color:#E8F5F1;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase reveal" style="color:#2ECC9A;">WHO WE HELP</span>
        <h2 class="font-heading font-semibold text-3xl sm:text-4xl mt-3 reveal reveal-d1" style="color:#1C3557;">
          We get your world. Not just websites.
        </h2>
        <p class="text-base mt-4 max-w-xl mx-auto" style="color:#1A2E3D;">
          Whether you're a plumber in Birmingham, a beauty therapist in Leeds,
          or an accountant in Manchester — your business isn't the same as everyone else's.
          Our web design for small businesses is always built around your trade, your area, your customers.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-7 shadow-sm hover:shadow-md transition-shadow reveal reveal-d1">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background-color:#E8F5F1;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="font-heading font-semibold text-lg mb-2" style="color:#1C3557;">Tradespeople</h3>
          <p class="text-sm leading-relaxed" style="color:#1A2E3D;">
            Plumbers, electricians, builders, landscapers. You're on-site all day.
            Your phone should ring from Google. We make that happen without you
            touching a thing.
          </p>
        </div>

        <div class="bg-white rounded-xl p-7 shadow-sm hover:shadow-md transition-shadow reveal reveal-d2">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background-color:#E8F5F1;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3 class="font-heading font-semibold text-lg mb-2" style="color:#1C3557;">Lifestyle &amp; beauty</h3>
          <p class="text-sm leading-relaxed" style="color:#1A2E3D;">
            Hair salons, beauty therapists, PTs, dog groomers. Instagram gets
            you so far. A proper website gets you found by people who've never
            heard of you yet.
          </p>
        </div>

        <div class="bg-white rounded-xl p-7 shadow-sm hover:shadow-md transition-shadow reveal reveal-d3">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background-color:#E8F5F1;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3 class="font-heading font-semibold text-lg mb-2" style="color:#1C3557;">Professional services</h3>
          <p class="text-sm leading-relaxed" style="color:#1A2E3D;">
            Accountants, consultants, IFAs, solicitors. You're credible in person.
            Your website should say the same. We build authority that works before
            you've even spoken.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- HOW IT WORKS -->
  <section id="how-it-works" class="py-20 bg-offwhite">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-semibold tracking-widest uppercase reveal" style="color:#2ECC9A;">THE PROCESS</span>
        <h2 class="font-heading font-semibold text-3xl sm:text-4xl mt-3 reveal reveal-d1" style="color:#1C3557;">
          Three steps. Then your phone starts ringing.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

        <!-- Step 1 -->
        <div class="reveal">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0" style="background-color:#2ECC9A;">1</div>
            <div class="h-px flex-1" style="background:linear-gradient(90deg,#2ECC9A,transparent); opacity:0.3;"></div>
          </div>
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5" style="background-color:#1C3557;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-3" style="color:#1C3557;">We build your website</h3>
          <p class="text-sm leading-relaxed" style="color:#1A2E3D;">SEO ready from the first line of code. Designed to rank, not just to look good. Live within 7 days, not 7 weeks.</p>
        </div>

        <!-- Step 2 -->
        <div class="reveal reveal-d1">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0" style="background-color:#2ECC9A;">2</div>
            <div class="h-px flex-1" style="background:linear-gradient(90deg,#2ECC9A,transparent); opacity:0.3;"></div>
          </div>
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5" style="background-color:#1C3557;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-3" style="color:#1C3557;">We manage everything</h3>
          <p class="text-sm leading-relaxed" style="color:#1A2E3D;">Updates, hosting, security and changes, all handled by us. You message us what you need. We sort it the same day.</p>
        </div>

        <!-- Step 3 -->
        <div class="reveal reveal-d2">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0" style="background-color:#2ECC9A;">3</div>
          </div>
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5" style="background-color:#1C3557;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <polyline points="11 8 11 11 13 13"/>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-3" style="color:#1C3557;">You get found</h3>
          <p class="text-sm leading-relaxed" style="color:#1A2E3D;">Google starts showing your business to people searching your trade in your area. Your phone rings. You do the work you're good at.</p>
        </div>

      </div>
    </div>
  </section>


  <!-- SERVICES -->
  <section class="py-20" style="background-color:#E8F5F1;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase reveal" style="color:#2ECC9A;">WHAT WE DO</span>
        <h2 class="font-heading font-semibold text-3xl sm:text-4xl mt-3 reveal reveal-d1" style="color:#1C3557;">
          Small business website design:<br class="hidden sm:block" /> everything you need, nothing you don't.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-8 shadow-sm flex flex-col">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background-color:#E8F5F1;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-3" style="color:#1C3557;">Starter Website</h3>
          <p class="text-sm leading-relaxed mb-6 flex-1" style="color:#1A2E3D;">
            A proper website, built fast and managed completely for you.
            SEO included from day one. No fiddling, no maintenance, no headaches.
            It just works.
          </p>
          <a href="/about#contact" aria-label="Find out more about the Starter Website package" class="inline-flex items-center gap-1.5 text-sm font-semibold" style="color:#2ECC9A;">
            Find out more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="rounded-xl p-8 flex flex-col relative overflow-hidden" style="background-color:#1C3557;">
          <div class="absolute top-0 right-0 text-xs font-semibold px-3 py-1.5 rounded-bl-xl" style="background-color:#2ECC9A; color:#fff;">Most popular</div>
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background-color:#243f68;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-3" style="color:#fff;">Growth Bundle</h3>
          <p class="text-sm leading-relaxed mb-6 flex-1" style="color:rgba(255,255,255,0.75);">
            Website plus monthly SEO. Blog posts, local search rankings, Google Search Console.
            This is where your phone starts ringing from people who've never heard of you.
          </p>
          <a href="/about#contact" aria-label="Find out more about the Growth Bundle package" class="inline-flex items-center gap-1.5 text-sm font-semibold" style="color:#2ECC9A;">
            Find out more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm flex flex-col">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background-color:#E8F5F1;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-3" style="color:#1C3557;">Full Service</h3>
          <p class="text-sm leading-relaxed mb-6 flex-1" style="color:#1A2E3D;">
            Website, SEO, and AI automation. Enquiry flows, follow-ups, smart systems
            that work while you sleep. For businesses serious about growing without
            doing more.
          </p>
          <a href="/about#contact" aria-label="Find out more about the Full Service package" class="inline-flex items-center gap-1.5 text-sm font-semibold" style="color:#2ECC9A;">
            Find out more <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ABOUT SNAPSHOT -->
  <section class="py-20 bg-offwhite">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

        <div class="rounded-2xl overflow-hidden shadow-md reveal" style="aspect-ratio:4/3;">
          <img
            src="/images/hero-collage.webp"
            alt="Anil Jaishi and the Pixova team working with small businesses across Birmingham"
            width="1400" height="781"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>

        <div>
          <span class="text-xs font-semibold tracking-widest uppercase reveal reveal-d1" style="color:#2ECC9A;">ABOUT PIXOVA</span>
          <h2 class="font-heading font-semibold text-3xl sm:text-4xl mt-3 mb-5" style="color:#1C3557;">
            A Birmingham digital agency<br class="hidden sm:block" /> built for real businesses
          </h2>
          <p class="text-sm leading-relaxed mb-4" style="color:#1A2E3D;">
            Pixova was started by Anil Jaishi — Digital Marketing graduate from the
            University of Birmingham — because he kept seeing the same thing: small
            businesses being overcharged for websites that did nothing.
          </p>
          <p class="text-sm leading-relaxed mb-8" style="color:#1A2E3D;">
            We use AI to build faster, smarter websites, then manage everything
            so you never think about it again. Serving businesses across Birmingham,
            the West Midlands, and the whole of the UK.
          </p>

          <div class="grid grid-cols-2 gap-6 mb-8">

            <div>
              <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-2" style="background-color:#E8F5F1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <span class="font-heading font-semibold text-2xl" style="color:#2ECC9A;">7 days</span>
              <p class="text-xs font-medium mt-1" style="color:#1A2E3D;">Average time to go live</p>
            </div>

            <div>
              <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-2" style="background-color:#E8F5F1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </div>
              <span class="font-heading font-semibold text-2xl" style="color:#2ECC9A;">100%</span>
              <p class="text-xs font-medium mt-1" style="color:#1A2E3D;">Managed, you do nothing</p>
            </div>

            <div>
              <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-2" style="background-color:#E8F5F1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <span class="font-heading font-semibold text-2xl" style="color:#2ECC9A;">UK-wide</span>
              <p class="text-xs font-medium mt-1" style="color:#1A2E3D;">Based in Birmingham</p>
            </div>

            <div>
              <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-2" style="background-color:#E8F5F1;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2ECC9A" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                </svg>
              </div>
              <span class="font-heading font-semibold text-2xl" style="color:#2ECC9A;">Zero</span>
              <p class="text-xs font-medium mt-1" style="color:#1A2E3D;">Tech knowledge needed</p>
            </div>

          </div>

          <a
            href="/about"
            class="inline-flex items-center gap-1.5 text-sm font-semibold"
            style="color:#1C3557;"
          >
            Meet Anil &amp; learn more
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- FINAL CTA -->
  <section class="py-20" style="background-color:#2ECC9A;">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-heading font-semibold text-3xl sm:text-4xl mb-4" style="color:#1C3557;">
        Your phone should be ringing<br class="hidden sm:block" /> from Google.
      </h2>
      <p class="mb-8 max-w-lg mx-auto" style="color:rgba(28,53,87,0.75);">
        Let's make that happen. No jargon, no waffle, just a quick
        chat about your business and what you need.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/about#contact"
          class="inline-flex items-center gap-2 font-semibold text-sm px-7 py-4 rounded-lg transition-colors min-h-[48px]"
          style="background-color:#1C3557; color:#fff;"
        >
          Get in touch
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href="https://wa.me/447786466109"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-sm px-7 py-4 rounded-lg border-2 transition-colors min-h-[48px]"
