---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Small Business Website Design | Pixova Birmingham"
  description="Pixova builds fast, SEO-ready websites for small businesses across the UK. We handle the design, the SEO and everything in between. Based in Birmingham. Live in 7 days."
  canonicalUrl="https://www.pixova.uk/"
>
  <link
    slot="head"
    rel="preload" as="image"
    href="/images/hero-anil.webp"
    fetchpriority="high"
  />
  <script slot="head" type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What does Pixova do?",
        "acceptedAnswer": { "@type": "Answer", "text": "Pixova builds fast, SEO-ready websites for small businesses across the UK, handles local SEO to get businesses found on Google, and sets up AI-powered marketing automation so enquiries are followed up automatically. Everything is fully managed — clients don't need any technical knowledge." }
      },
      {
        "@type": "Question",
        "name": "How much does a small business website cost?",
        "acceptedAnswer": { "@type": "Answer", "text": "Pixova offers three packages: a Starter Website (a fully managed, SEO-ready site built in around 7 days), a Growth Bundle (website plus monthly SEO and blog content), and a Full Service package (website, SEO, and AI marketing automation). All packages are fully managed with no hidden fees." }
      },
      {
        "@type": "Question",
        "name": "How long does local SEO take to work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Local SEO typically takes three to six months before you see consistent results. Google needs time to find, crawl, and trust a new or improved website before ranking it. The results compound over time — a site that ranks keeps ranking without ongoing ad spend." }
      },
      {
        "@type": "Question",
        "name": "What is marketing automation for small businesses?",
        "acceptedAnswer": { "@type": "Answer", "text": "Marketing automation means setting up systems that respond to enquiries, follow up with leads, and request reviews automatically — without you doing anything manually. For example: a new enquiry arrives on your website and within two minutes the customer receives a professional acknowledgement email. A lead who doesn't book immediately receives follow-up messages over the next two weeks. A completed job triggers an automatic request for a Google review. These systems are set up once and run indefinitely." }
      },
      {
        "@type": "Question",
        "name": "Can AI automation help a small business get more customers?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. AI automation helps small businesses respond faster to enquiries (which significantly increases conversion rates), follow up with leads consistently, and handle repetitive tasks like review requests and appointment reminders. Pixova builds these systems as part of the Full Service package — they are set up once and run in the background while you focus on your work." }
      },
      {
        "@type": "Question",
        "name": "Does Pixova work with businesses outside Birmingham?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Pixova is based in Birmingham but works with small and medium businesses across the whole of the UK. All services — web design, local SEO, and marketing automation — are delivered remotely." }
      },
      {
        "@type": "Question",
        "name": "How quickly can Pixova build my website?",
        "acceptedAnswer": { "@type": "Answer", "text": "Pixova's average time to go live is 7 days from the point of starting. The site is built fast using AI-assisted development, then fully managed so clients never need to touch it again." }
      },
      {
        "@type": "Question",
        "name": "What types of businesses does Pixova work with?",
        "acceptedAnswer": { "@type": "Answer", "text": "Pixova works with tradespeople (plumbers, electricians, builders, landscapers, roofers), professional services (accountants, solicitors, consultants, financial advisors), and lifestyle and beauty businesses (salons, therapists, personal trainers, studios). Essentially any UK small business that needs to be found on Google and wants its online presence fully managed." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between local SEO and regular SEO?",
        "acceptedAnswer": { "@type": "Answer", "text": "Regular SEO tries to rank a website nationally for broad terms. Local SEO focuses on ranking in a specific geographic area — targeting searches like 'plumber Birmingham' or 'accountant Manchester' rather than 'plumber UK'. For most small businesses, local SEO is far more valuable because it targets people in your area who are ready to buy right now." }
      },
      {
        "@type": "Question",
        "name": "Do I need any technical knowledge to work with Pixova?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Pixova handles everything — building the website, setting up SEO, managing content, and building any automation systems. Clients do not need to know anything technical. The whole point is that it is fully managed so business owners can focus on running their business." }
      }
    ]
  })}</script>

  <!-- URGENCY BAR ─────────────────────────────────────── -->
  <div id="urgency-bar" class="sticky top-16 z-40" style="overflow:hidden; max-height:200px; background:rgba(13,34,64,0.98); border-bottom:1px solid rgba(46,204,154,0.2); backdrop-filter:blur(8px); transition:max-height 0.4s ease, opacity 0.3s ease;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="live-dot flex-shrink-0"></span>
        <span class="text-xs sm:text-sm font-medium" style="color:rgba(255,255,255,0.8);">
          Only <strong style="color:#2ECC9A;">2 free spots</strong> left this month. Grab yours before they go.
        </span>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href="/about?offer=free-site#contact" class="text-xs font-bold px-3 py-1.5 rounded-full whitespace-nowrap hidden sm:inline-block" style="background:#2ECC9A; color:#0D2240;">
          Claim yours →
        </a>
        <button id="urgency-close" class="w-7 h-7 flex items-center justify-center rounded-full flex-shrink-0" style="color:rgba(255,255,255,0.4); background:rgba(255,255,255,0.06); border:none; cursor:pointer;" aria-label="Dismiss">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- HERO ─────────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden flex items-center"
    style="background:linear-gradient(135deg, #ffffff 0%, #e8f5f1 45%, #c8e8d8 100%); min-height:calc(100svh - 64px);"
  >
    <!-- Teal glow — top right -->
    <div class="orb absolute pointer-events-none" style="width:750px;height:750px;top:-200px;right:-200px;border-radius:50%;background:radial-gradient(circle, rgba(46,204,154,0.22) 0%, transparent 55%);"></div>
    <!-- Navy accent — centre left -->
    <div class="orb-2 absolute pointer-events-none" style="width:600px;height:600px;top:10%;left:-150px;border-radius:50%;background:radial-gradient(circle, rgba(13,34,64,0.06) 0%, transparent 55%);"></div>
    <!-- Teal glow — bottom right -->
    <div class="orb absolute pointer-events-none" style="width:500px;height:500px;bottom:-150px;right:10%;border-radius:50%;background:radial-gradient(circle, rgba(46,204,154,0.15) 0%, transparent 55%);"></div>
    <!-- Teal accent — bottom left -->
    <div class="orb-2 absolute pointer-events-none" style="width:400px;height:400px;bottom:-80px;left:20%;border-radius:50%;background:radial-gradient(circle, rgba(46,204,154,0.1) 0%, transparent 55%);"></div>


    <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full py-16 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-14 items-center">

        <!-- Left: text -->
        <div class="order-2 lg:order-1 hero-animate">
          <div class="flex items-center gap-2 mb-5">
            <span class="block w-5 h-0.5 rounded" style="background:rgba(13,34,64,0.4);"></span>
            <span class="sec-label" style="color:rgba(13,34,64,0.65);">Web Design & SEO · Birmingham · UK-Wide</span>
          </div>
          <h1 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl leading-tight mb-5" style="color:#0D2240; letter-spacing:-0.025em;">
            We build websites for<br/>small businesses, handle<br/><span style="color:#2ECC9A;">your SEO, and get results.</span>
          </h1>

          <p class="text-base sm:text-lg leading-relaxed mb-8 max-w-lg" style="color:rgba(13,34,64,0.7);">
            We handle the whole thing. Website design, SEO, hosting and updates.
            Most clients go live within 7 days. Your only job is to answer the phone.
          </p>

          <div class="flex flex-wrap gap-3 mb-5">
            <a href="/about#contact" class="btn-p" style="background-color:#0D2240; color:#fff; box-shadow:0 4px 20px rgba(13,34,64,0.25);">
              Let's have a chat
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#how-it-works" class="btn-g" style="border-color:rgba(13,34,64,0.35); color:#0D2240;">
              See how it works
            </a>
          </div>

          <!-- Free site offer -->
          <a href="/about?offer=free-site#contact" class="inline-flex items-center gap-3 mb-10 rounded-xl px-4 py-3 group transition-all" style="background:rgba(13,34,64,0.08); border:1px solid rgba(13,34,64,0.2);">
            <span class="flex-shrink-0 text-xs font-black uppercase tracking-wider px-2 py-1 rounded-md" style="background:#0D2240; color:#2ECC9A;">5 spots</span>
            <span class="text-sm font-semibold" style="color:#0D2240;">Claim your free website. Only 5 spots this month.</span>
            <svg class="flex-shrink-0 transition-transform group-hover:translate-x-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0D2240" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

          <div class="flex flex-wrap gap-x-5 gap-y-2 hero-animate-delay">
            {['UK-based team', 'Live in 7 days', 'Fully managed', 'No long contracts'].map(badge => (
              <span class="flex items-center gap-1.5 text-xs font-medium" style="color:rgba(13,34,64,0.65);">
                <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:rgba(13,34,64,0.5);"></span>
                {badge}
              </span>
            ))}
          </div>
        </div>

        <!-- Right: bento card grid -->
        <div class="order-1 lg:order-2 hidden sm:grid grid-cols-2 gap-3 hero-animate-images">

          <!-- Card 1: Photo + enquiries badge -->
          <div class="relative rounded-2xl overflow-hidden" style="height:260px; grid-column:1; grid-row:1;">
            <img
              src="/images/hero-anil.webp"
              alt="Anil Jaishi, founder of Pixova Birmingham web design agency"
              width="800" height="446"
              loading="eager" fetchpriority="high"
              class="w-full h-full object-cover object-top"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(13,34,64,0.8) 0%, transparent 55%);"></div>
            <!-- Badge -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center gap-2.5 rounded-xl px-3 py-2.5" style="background:rgba(13,34,64,0.88); backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,0.12);">
              <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#2ECC9A;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0D2240" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <div>
                <p class="text-white text-xs font-semibold leading-tight" style="font-family:'DM Sans',sans-serif;">Live in 7 days</p>
                <p class="text-xs leading-tight" style="color:rgba(255,255,255,0.7);">Not 7 weeks</p>
              </div>
            </div>
          </div>

          <!-- Card 2: Stat card -->
          <div class="rounded-2xl p-5 flex flex-col justify-between" style="background:#E8F5F1; height:260px; grid-column:2; grid-row:1;">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:#2ECC9A; letter-spacing:0.1em;">UK-wide reach</p>
              <div class="font-heading font-bold text-5xl leading-none mb-2" style="color:#1C3557; letter-spacing:-0.04em;">100<span style="color:#2ECC9A; font-size:2rem;">%</span></div>
              <p class="text-xs leading-relaxed" style="color:#556272;">Fully managed — hosting, updates, security. You do nothing.</p>
            </div>
            <div>
              <div class="h-1 rounded-full mb-1" style="background:#E8F5F1; overflow:hidden;">
                <div class="h-full rounded-full" style="width:100%; background:linear-gradient(90deg,#2ECC9A,#1db37a);"></div>
              </div>
              <p class="text-xs" style="color:#a0b0bc;">Managed clients</p>
            </div>
          </div>

          <!-- Card 3: Dark chart card (spans full width) -->
          <div class="col-span-2 rounded-2xl p-5 flex items-center justify-between gap-4" style="background:linear-gradient(135deg,#0D1F2D 0%,#1C3557 100%); height:140px;">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:#2ECC9A; letter-spacing:0.08em;">SEO &amp; traffic growth</p>
              <p class="font-heading font-bold text-base leading-snug" style="color:#fff;">Your Google rankings,<br/>handled for you.</p>
            </div>
            <!-- Mini bar chart -->
            <div class="flex items-end gap-1.5 flex-shrink-0" style="height:56px;">
              {[25,40,35,28,60,75,65,100].map((h, i) => (
                <div
                  class="rounded-sm"
                  style={`width:12px; height:${h}%; background:${i >= 4 ? '#2ECC9A' : 'rgba(255,255,255,0.15)'};`}
                ></div>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Live stats bar -->
      <div class="mt-12 pt-8 relative z-10" style="border-top:1px solid rgba(13,34,64,0.15);">
        <div class="flex flex-wrap items-center gap-6 sm:gap-10">

          <!-- Live indicator -->
          <div class="flex items-center gap-2 flex-shrink-0">
            <span class="live-dot" style="background:#0D2240; box-shadow:none; animation:none;"></span>
            <span class="text-xs font-semibold uppercase tracking-widest" style="color:rgba(13,34,64,0.5);">Live</span>
          </div>

          <div class="w-px h-6 flex-shrink-0 hidden sm:block" style="background:rgba(13,34,64,0.15);"></div>

          <!-- Stats -->
          <div class="flex flex-wrap gap-6 sm:gap-10">
            {[
              { target: 3,  suffix: '',  label: 'sites built this week' },
              { target: 2,  suffix: '',  label: 'currently in progress' },
              { target: 11, suffix: '',  label: 'launched this month' },
            ].map((s, i) => (
              <div class="flex items-baseline gap-2">
                <span
                  class="live-counter font-heading font-black text-2xl leading-none"
                  data-target={s.target}
                  data-delay={i * 120}
                  style="color:#0D2240; letter-spacing:-0.03em;"
                >0</span>
                <span class="text-xs" style="color:rgba(13,34,64,0.55);">{s.label}</span>
              </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  </section>


  <!-- TESTIMONIALS ───────────────────────────────────── -->
  <section class="py-20 bg-offwhite">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="mb-10">
        <span class="sec-label reveal">CLIENT RESULTS</span>
        <h2 class="font-heading font-bold text-3xl sm:text-4xl mt-2 reveal reveal-d1" style="color:#1C3557; letter-spacing:-0.025em;">
          Don't take our word for it.
        </h2>
        <p class="text-base mt-3 max-w-lg reveal reveal-d2" style="color:#4a6070; line-height:1.7;">
          Three businesses, three different services. Here's what actually happened.
        </p>
      </div>

      <!-- Masonry: Jake tall left, Ayoush + Luke stacked right -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-stretch">

        <!-- Jake — tall left, dark navy -->
        <div class="reveal rounded-2xl overflow-hidden flex flex-col" style="background:linear-gradient(160deg,#0D2240 0%,#1C3557 100%); border:1px solid rgba(46,204,154,0.15); box-shadow:0 4px 30px rgba(13,34,64,0.2);">
          <div style="height:3px; background:linear-gradient(90deg,#2ECC9A 0%,rgba(46,204,154,0.15) 100%);"></div>

          <!-- Photo + identity centred -->
          <div class="flex flex-col items-center pt-9 pb-7 px-8">
            <div style="width:88px; height:88px; border-radius:50%; padding:3px; background:linear-gradient(135deg,#2ECC9A,#1db37a); flex-shrink:0;">
              <img
                src="/images/jake-victor.webp"
                alt="Jake Victor"
                width="82" height="82"
                loading="lazy"
                style="width:100%; height:100%; border-radius:50%; object-fit:cover; object-position:top; display:block; border:3px solid #0D2240;"
              />
            </div>
            <p class="font-heading font-bold mt-3 mb-0.5" style="color:#fff; font-size:1rem;">Jake Victor</p>
            <p style="font-size:0.7rem; color:rgba(255,255,255,0.45); letter-spacing:0.04em;">Website &amp; SEO · Birmingham</p>
            <div class="flex gap-1 mt-2">
              {[1,2,3,4,5].map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
          </div>

          <!-- Divider -->
          <div class="mx-8" style="height:1px; background:rgba(46,204,154,0.12);"></div>

          <!-- Journey steps -->
          <div class="px-8 pt-7 pb-5 flex-1">
            <p class="text-xs font-bold uppercase tracking-widest mb-5" style="color:#2ECC9A; letter-spacing:0.1em;">Client journey</p>
            <div class="flex flex-col">

              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background:rgba(46,204,154,0.15); color:#2ECC9A; border:1.5px solid rgba(46,204,154,0.4);">1</div>
                  <div class="w-px flex-1 my-1.5" style="background:rgba(46,204,154,0.18); min-height:24px;"></div>
                </div>
                <div class="pb-5 pt-0.5">
                  <p class="font-semibold text-sm mb-1" style="color:rgba(255,255,255,0.9);">No online presence</p>
                  <p class="text-xs leading-relaxed" style="color:rgba(255,255,255,0.45);">Invisible on Google. Relying on word of mouth with no way to reach new customers searching online.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background:rgba(46,204,154,0.15); color:#2ECC9A; border:1.5px solid rgba(46,204,154,0.4);">2</div>
                  <div class="w-px flex-1 my-1.5" style="background:rgba(46,204,154,0.18); min-height:24px;"></div>
                </div>
                <div class="pb-5 pt-0.5">
                  <p class="font-semibold text-sm mb-1" style="color:rgba(255,255,255,0.9);">Website live in 7 days</p>
                  <p class="text-xs leading-relaxed" style="color:rgba(255,255,255,0.45);">Fast, SEO-ready and fully managed from day one. Jake handed over the brief and we handled everything else.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div>
                  <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background:#2ECC9A; color:#0D2240;">3</div>
                </div>
                <div class="pt-0.5">
                  <p class="font-semibold text-sm mb-1" style="color:rgba(255,255,255,0.9);">Phone started ringing from Google</p>
                  <p class="text-xs leading-relaxed" style="color:rgba(255,255,255,0.45);">New customers calling within the first month. People who had never heard of him, finding him through search.</p>
                </div>
              </div>

            </div>
          </div>

          <!-- Quote block -->
          <div class="mx-8 mb-8 rounded-xl px-5 py-4" style="background:rgba(255,255,255,0.05); border:1px solid rgba(46,204,154,0.12);">
            <svg width="24" height="18" viewBox="0 0 24 18" fill="none" aria-hidden="true" class="mb-2" style="opacity:0.35;">
              <path d="M0 18V10.8C0 7.2 1.2 4.2 3.6 1.8L6 4.2C4.8 5.4 4.2 6.9 4.2 8.4H7.8V18H0ZM13.2 18V10.8C13.2 7.2 14.4 4.2 16.8 1.8L19.2 4.2C18 5.4 17.4 6.9 17.4 8.4H21V18H13.2Z" fill="#2ECC9A"/>
            </svg>
            <p style="font-size:0.9rem; color:rgba(255,255,255,0.78); line-height:1.7; font-style:italic;">"Honestly the best money we've spent on marketing."</p>
          </div>
        </div>

        <!-- Right column: Ayoush + Luke stacked -->
        <div class="flex flex-col gap-5">

          <!-- Ayoush — white card -->
          <div class="reveal reveal-d1 rounded-2xl overflow-hidden flex-1" style="background:#fff; border:1px solid #e2eeea; box-shadow:0 2px 20px rgba(28,53,87,0.07);">
            <div style="height:3px; background:linear-gradient(90deg,#2ECC9A 0%,rgba(46,204,154,0.12) 100%);"></div>
            <div class="p-7">

              <!-- Person row -->
              <div class="flex items-center gap-4 mb-6">
                <div style="width:72px; height:72px; border-radius:50%; padding:3px; background:linear-gradient(135deg,#2ECC9A,#1db37a); flex-shrink:0;">
                  <img
                    src="/images/ayoush.webp"
                    alt="Ayoush, Founder of TranoVex"
                    width="66" height="66"
                    loading="lazy"
                    style="width:100%; height:100%; border-radius:50%; object-fit:cover; object-position:top; display:block; border:3px solid #fff;"
                  />
                </div>
                <div class="flex-1">
                  <div class="flex gap-0.5 mb-1">
                    {[1,2,3,4,5].map(() => (
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    ))}
                  </div>
                  <p class="font-heading font-bold" style="color:#1C3557; font-size:0.95rem;">Ayoush</p>
                  <p class="text-xs" style="color:#7a909e;">Founder, TranoVex</p>
                </div>
                <div class="flex-shrink-0">
                  <div class="inline-flex items-center gap-1.5 rounded-full px-3 py-1" style="background:#E8F5F1; border:1px solid rgba(46,204,154,0.3);">
                    <span class="w-1.5 h-1.5 rounded-full" style="background:#2ECC9A;"></span>
                    <span class="text-xs font-semibold" style="color:#1C3557;">Website &amp; SEO</span>
                  </div>
                </div>
              </div>

              <!-- Quote -->
              <svg width="28" height="20" viewBox="0 0 24 18" fill="none" aria-hidden="true" class="mb-3" style="opacity:0.2;">
