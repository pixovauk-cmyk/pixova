---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../data/site';

const navLinks = [
  { href: '/', label: 'Home', match: ['/'] },
  { href: '/services/', label: 'Services', match: ['/services/', '/web-design/', '/local-seo/', '/web-design-birmingham/'] },
  { href: '/custom-software/', label: 'Software', match: ['/custom-software/'] },
  { href: '/designs/', label: 'Designs', match: ['/designs/'] },
  { href: '/pricing/', label: 'Pricing', match: ['/pricing/'] },
  { href: '/reviews/', label: 'Reviews', match: ['/reviews/'] },
  { href: '/blog/', label: 'Blog', match: ['/blog/'] },
  { href: '/about/', label: 'About', match: ['/about/'] },
  { href: '/contact/', label: 'Contact', match: ['/contact/'] },
];

const path = Astro.url.pathname;
const isActive = (match: string[]) => match.some(m => (m === '/' ? path === '/' : path.startsWith(m)));
---

<header id="site-header" class="sticky top-0 z-50 transition-[background-color,box-shadow] duration-200">
  <div class="wrap flex items-center justify-between gap-4 py-4 xl:py-[22px]">
    <a href="/" class="flex items-center min-h-11 shrink-0" aria-label="Pixova home"><Logo /></a>

    <nav aria-label="Main" class="hidden xl:flex items-center gap-0.5 p-[5px] rounded-full bg-white/70 border border-[rgba(7,17,31,0.06)] backdrop-blur-md shadow-[0_10px_30px_-18px_rgba(7,17,31,0.25)]">
      {navLinks.map(l => isActive(l.match) ? (
        <a href={l.href} aria-current="page" class="inline-flex items-center gap-2 min-h-10 px-4 rounded-full bg-navy text-white text-sm font-medium">
          {l.label} <span class="w-[5px] h-[5px] rounded-full bg-teal"></span>
        </a>
      ) : (
        <a href={l.href} class="inline-flex items-center min-h-10 px-3 rounded-full text-sm text-body hover:text-navy hover:bg-navy/5 transition-colors">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/gap-report/" class="hidden sm:inline-flex items-center gap-2.5 min-h-12 pl-[18px] pr-1.5 rounded-full border border-[rgba(7,17,31,0.08)] bg-white text-navy text-sm font-semibold hover:shadow-md transition-shadow">
        Free Gap Report
        <span class="w-[34px] h-[34px] rounded-full grid place-items-center" style="background:var(--grad)"><Icon name="arrow" size={14} stroke={2.6} /></span>
      </a>
      <button id="menu-toggle" class="xl:hidden w-12 h-12 grid place-items-center rounded-full bg-white border border-[rgba(7,17,31,0.08)]" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="ico-open"><Icon name="menu" size={20} stroke={2} /></span>
        <span class="ico-close hidden"><Icon name="close" size={20} stroke={2} /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="xl:hidden" hidden aria-label="Mobile">
    <div class="wrap pb-5">
      <div class="rounded-[28px] bg-white border border-line shadow-[0_30px_60px_-30px_rgba(7,17,31,0.35)] p-3">
        {navLinks.map(l => (
          <a href={l.href} aria-current={isActive(l.match) ? 'page' : undefined} class={`flex items-center justify-between min-h-12 px-4 rounded-2xl text-[17px] font-medium ${isActive(l.match) ? 'bg-navy text-white' : 'text-navy hover:bg-soft'}`}>
            {l.label}
            {isActive(l.match) && <span class="w-1.5 h-1.5 rounded-full bg-teal"></span>}
          </a>
        ))}
        <div class="grid grid-cols-2 gap-2 pt-3">
          <a href="/gap-report/" class="btn btn-grad btn-sm">Free Gap Report</a>
          <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn btn-dark btn-sm">WhatsApp</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    if (!nav) return;
    nav.hidden = !nav.hidden;
    toggle.setAttribute('aria-expanded', String(!nav.hidden));
    toggle.setAttribute('aria-label', nav.hidden ? 'Open menu' : 'Close menu');
    toggle.querySelector('.ico-open')?.classList.toggle('hidden', !nav.hidden);
    toggle.querySelector('.ico-close')?.classList.toggle('hidden', nav.hidden);
  });
  const header = document.getElementById('site-header');
  const onScroll = () => {
    const scrolled = window.scrollY > 12;
    header?.classList.toggle('bg-white/85', scrolled);
    header?.classList.toggle('backdrop-blur-md', scrolled);
    header?.classList.toggle('shadow-[0_10px_30px_-24px_rgba(7,17,31,0.35)]', scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
