---
import { SITE } from '../data/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-white px-4 pb-4">
  <div class="art relative max-w-[1408px] mx-auto rounded-[36px]">
    <img src="/images/art/aurora-dark.jpg" alt="" class="art-bg opacity-70" loading="lazy" />
    <div class="art-shade" style="background:linear-gradient(180deg, rgba(7,17,31,0.2) 0%, rgba(7,17,31,0.85) 60%)"></div>
    <div class="art-body p-8 sm:p-12 lg:p-16 flex flex-col gap-12">
      <div class="flex flex-col gap-3.5">
        <span class="text-base text-[#B9C4D0]">Got a business? Want your phone ringing?</span>
        <span class="font-medium leading-[0.92] tracking-[-0.06em] text-[clamp(48px,8vw,120px)]">Built To Grow. <span class="grad-text" style="background-image:var(--grad)">Built To Rank.</span></span>
      </div>

      <div class="grid gap-10 pt-8 border-t border-white/10 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
        <form id="footer-gap" action="/gap-report/" class="flex flex-col gap-3 min-w-0">
          <label for="fb-site" class="font-semibold">Get your free Gap Report</label>
          <span class="text-[13px] text-[#A9B6C4]">See who's beating you on Google, and why. 60 seconds, no card.</span>
          <div class="flex flex-wrap gap-2 p-1.5 rounded-full bg-navy-2 border border-white/10 max-w-[460px]">
            <input id="fb-site" name="website" type="text" inputmode="url" placeholder="yourwebsite.co.uk" class="flex-1 basis-[160px] min-w-0 min-h-[46px] px-4 rounded-full bg-transparent text-white text-[15px] placeholder:text-[#7A8591] focus:outline-none" />
            <button type="submit" class="min-h-[46px] px-5 rounded-full bg-teal text-navy font-semibold text-sm">Check now</button>
          </div>
        </form>

        <nav aria-label="Services" class="flex flex-col gap-1 text-[15px]">
          <span class="text-[13px] text-[#8E9BAA] mb-2">Services</span>
          <a href="/web-design/" class="text-[#DCE3EA] hover:text-teal py-1">Websites</a>
          <a href="/local-seo/" class="text-[#DCE3EA] hover:text-teal py-1">Local SEO</a>
          <a href="/custom-software/" class="text-[#DCE3EA] hover:text-teal py-1">Custom software</a>
          <a href="/web-design-birmingham/" class="text-[#DCE3EA] hover:text-teal py-1">Web design Birmingham</a>
          <a href="/designs/" class="text-[#DCE3EA] hover:text-teal py-1">Design catalogue</a>
        </nav>

        <nav aria-label="Company" class="flex flex-col gap-1 text-[15px]">
          <span class="text-[13px] text-[#8E9BAA] mb-2">Company</span>
          <a href="/about/" class="text-[#DCE3EA] hover:text-teal py-1">About</a>
          <a href="/reviews/" class="text-[#DCE3EA] hover:text-teal py-1">Reviews</a>
          <a href="/pricing/" class="text-[#DCE3EA] hover:text-teal py-1">Pricing</a>
          <a href="/blog/" class="text-[#DCE3EA] hover:text-teal py-1">Blog</a>
          <a href="/contact/" class="text-[#DCE3EA] hover:text-teal py-1">Contact</a>
        </nav>

        <div class="flex flex-col gap-1 text-[15px]">
          <span class="text-[13px] text-[#8E9BAA] mb-2">Talk to me</span>
          <a href={SITE.whatsapp} target="_blank" rel="noopener" class="text-[#DCE3EA] hover:text-teal py-1">WhatsApp {SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} class="text-[#DCE3EA] hover:text-teal py-1">{SITE.email}</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener" class="text-[#DCE3EA] hover:text-teal py-1">LinkedIn</a>
          <a href={SITE.facebook} target="_blank" rel="noopener" class="text-[#DCE3EA] hover:text-teal py-1">Facebook</a>
        </div>
      </div>

      <div class="flex flex-wrap justify-between items-center gap-4">
        <a href="/" aria-label="Pixova home"><Logo dark /></a>
        <div class="flex flex-wrap gap-5 text-[13px] text-[#A9B6C4]">
          <span>© {year} Pixova · Birmingham, UK · Not VAT registered</span>
          <a href="/privacy-policy/" class="hover:text-white">Privacy</a>
          <a href="/cookie-policy/" class="hover:text-white">Cookies</a>
          <a href="/terms/" class="hover:text-white">Terms</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('footer-gap')?.addEventListener('submit', (e) => {
    e.preventDefault();
    let val = (document.getElementById('fb-site') as HTMLInputElement).value.trim();
    if (!val) { window.location.href = '/gap-report/'; return; }
    if (!/^https?:\/\//i.test(val)) val = 'https://' + val;
    window.location.href = '/gap-report/?website=' + encodeURIComponent(val);
  });
</script>
