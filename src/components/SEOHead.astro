---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  schema?: object;
  noindex?: boolean;
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified: string;
  };
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = 'https://www.pixova.uk/images/og-image.jpg',
  schema,
  noindex = false,
  articleSchema,
  breadcrumbs,
} = Astro.props;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Pixova',
  url: 'https://www.pixova.uk',
  logo: 'https://www.pixova.uk/favicon.svg',
  image: ogImage,
  description:
    'Pixova builds websites, handles local SEO and makes small custom software for UK small businesses. Based in Birmingham.',
  telephone: '+447786366109',
  email: 'hello@pixova.uk',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Birmingham',
    addressRegion: 'England',
    addressCountry: 'GB',
  },
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  founder: {
    '@type': 'Person',
    name: 'Anil Jaishi',
    url: 'https://www.linkedin.com/in/anil-jaishi-150050208/',
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'University of Birmingham',
    },
  },
  sameAs: [
    'https://www.facebook.com/people/Pixova/61589529080471/',
    'https://www.linkedin.com/in/anil-jaishi-150050208/',
  ],
  priceRange: '££',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Small business services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Small business website design', url: 'https://www.pixova.uk/web-design/' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Local SEO', url: 'https://www.pixova.uk/local-seo/' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom software for small businesses', url: 'https://www.pixova.uk/custom-software/' }, priceSpecification: { '@type': 'PriceSpecification', minPrice: 200, priceCurrency: 'GBP' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Google Business Profile setup' } },
    ],
  },
};

const activeSchema = schema ?? defaultSchema;

const articleJsonLd = articleSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: articleSchema.headline,
      author: { '@type': 'Person', name: 'Anil Jaishi' },
      publisher: {
        '@type': 'Organization',
        name: 'Pixova',
        logo: { '@type': 'ImageObject', url: 'https://www.pixova.uk/favicon.svg' },
      },
      datePublished: articleSchema.datePublished,
      dateModified: articleSchema.dateModified,
    }
  : null;

const breadcrumbJsonLd = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.url })),
    }
  : null;
---

<!-- Primary meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="theme-color" content="#FAFAF7" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Pixova" />
<meta property="og:locale" content="en_GB" />

<!-- Twitter card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Schema -->
<script type="application/ld+json" set:html={JSON.stringify(activeSchema)} />
{articleJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
)}
{breadcrumbJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
)}
