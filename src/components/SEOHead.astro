---
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  schema?: object;
  articleSchema?: {
    headline: string;
    datePublished: string;
    dateModified: string;
  };
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = 'https://www.pixova.uk/images/og-image.jpg',
  schema,
  articleSchema,
} = Astro.props;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Pixova',
  url: 'https://www.pixova.uk',
  logo: 'https://www.pixova.uk/favicon.svg',
  image: ogImage,
  description:
    'Pixova builds fast, SEO-ready websites and handles local SEO for small and medium businesses across the UK. Based in Birmingham.',
  telephone: '+447786366109',
  email: 'hello@pixova.uk',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Birmingham',
    addressRegion: 'England',
    addressCountry: 'GB',
  },
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  founder: {
    '@type': 'Person',
    name: 'Anil Jaishi',
    url: 'https://www.linkedin.com/in/anil-jaishi-150050208/',
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'University of Birmingham',
    },
  },
  sameAs: [
    'https://www.facebook.com/profile.php?id=61589529080471',
    'https://www.linkedin.com/in/anil-jaishi-150050208/',
  ],
  priceRange: '££',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital Marketing Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Small Business Website Design', description: 'Fast, SEO-ready websites for small businesses built in around 7 days and fully managed.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Local SEO', description: 'Local search engine optimisation to get small businesses found on Google in their area.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Marketing Automation', description: 'AI-powered marketing automation including enquiry response systems, lead follow-up sequences, and review request automation.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Google Business Profile Optimisation', description: 'Setup and optimisation of Google Business Profile to improve local search visibility and Google Maps rankings.' } },
    ],
  },
  review: {
    '@type': 'Review',
    author: { '@type': 'Person', name: 'Jake Victor' },
    reviewBody: 'Within 90 days of launching our new site with Pixova, we were getting consistent enquiries from Google — people who had never heard of us before. The whole process was managed completely, we didn\'t have to do a thing.',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  },
};

const activeSchema = schema ?? defaultSchema;

const articleJsonLd = articleSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: articleSchema.headline,
      author: { '@type': 'Person', name: 'Anil Jaishi' },
      publisher: {
        '@type': 'Organization',
        name: 'Pixova',
        logo: { '@type': 'ImageObject', url: 'https://www.pixova.uk/favicon.svg' },
      },
      datePublished: articleSchema.datePublished,
      dateModified: articleSchema.dateModified,
    }
  : null;
---

<!-- Primary meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Preconnect to external origins -->
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="dns-prefetch" href="https://www.google-analytics.com" />

<!-- Google Search Console verification placeholder -->
<!-- <meta name="google-site-verification" content="REPLACE_WITH_GSC_TOKEN" /> -->

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Pixova" />
<meta property="og:locale" content="en_GB" />

<!-- Twitter card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Schema -->
<script type="application/ld+json" set:html={JSON.stringify(activeSchema)} />
{articleJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
)}

