---
// Small, friendly illustrations of each tool, drawn as a phone screen.
import type { ToolKind } from '../data/software';

interface Props { kind: ToolKind; }
const { kind } = Astro.props;

const navy = '#0D2240';
const teal = '#2ECC9A';
const mint = '#E8F5F1';
const line = '#E3E8EC';
const ui = "Inter Variable, sans-serif";
---

<svg viewBox="0 0 320 240" role="img" aria-label={`Illustration: ${kind}`} class="w-full h-auto block">
  <rect width="320" height="240" rx="18" fill={mint} />
  <!-- phone -->
  <rect x="96" y="18" width="128" height="222" rx="20" fill={navy} />
  <rect x="102" y="24" width="116" height="216" rx="15" fill="#fff" />
  <rect x="140" y="30" width="40" height="6" rx="3" fill={navy} opacity="0.85" />

  {kind === 'quote' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Get a price</text>
      <rect x="112" y="66" width="96" height="18" rx="5" fill="#fff" stroke={line} /><text x="118" y="78" font-size="7.5" fill="#5B6B7A">3 bedrooms</text>
      <rect x="112" y="90" width="96" height="18" rx="5" fill="#fff" stroke={line} /><text x="118" y="102" font-size="7.5" fill="#5B6B7A">Weekly clean</text>
      <rect x="112" y="114" width="96" height="18" rx="5" fill="#fff" stroke={line} /><text x="118" y="126" font-size="7.5" fill="#5B6B7A">B13 postcode</text>
      <rect x="112" y="142" width="96" height="40" rx="8" fill={mint} />
      <text x="160" y="156" text-anchor="middle" font-size="7" fill="#5B6B7A">Your price</text>
      <text x="160" y="174" text-anchor="middle" font-size="16" font-weight="800" fill={navy}>£48</text>
      <rect x="112" y="190" width="96" height="22" rx="11" fill={teal} /><text x="160" y="204" text-anchor="middle" font-size="8" font-weight="700" fill={navy}>Book this</text>
    </g>
  )}

  {kind === 'booking' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Thu 12 Dec</text>
      {['9:00', '10:30', '12:00', '14:00', '15:30', '17:00'].map((t, i) => (
        <g>
          <rect x={112 + (i % 2) * 50} y={68 + Math.floor(i / 2) * 26} width="46" height="20" rx="6" fill={i === 3 ? teal : '#fff'} stroke={i === 3 ? teal : line} />
          <text x={135 + (i % 2) * 50} y={81 + Math.floor(i / 2) * 26} text-anchor="middle" font-size="8" font-weight="600" fill={navy} opacity={i === 1 ? 0.3 : 1}>{t}</text>
        </g>
      ))}
      <text x="112" y="160" font-size="7.5" fill="#5B6B7A">Deposit today</text>
      <text x="208" y="160" text-anchor="end" font-size="8" font-weight="700" fill={navy}>£10.00</text>
      <rect x="112" y="170" width="96" height="22" rx="11" fill={navy} /><text x="160" y="184" text-anchor="middle" font-size="8" font-weight="700" fill="#fff">Confirm booking</text>
      <rect x="112" y="200" width="96" height="16" rx="5" fill={mint} /><text x="160" y="211" text-anchor="middle" font-size="6.5" fill={navy}>Text reminder the day before</text>
    </g>
  )}

  {kind === 'jobs' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Today's jobs</text>
      {[['Boiler service', '14 Oak Rd', true], ['Leaking tap', '3 Mill Ln', false], ['New radiator', '88 High St', false]].map(([t, a, done], i) => (
        <g>
          <rect x="112" y={66 + i * 46} width="96" height="40" rx="8" fill="#fff" stroke={line} />
          <circle cx="124" cy={86 + i * 46} r="6" fill={done ? teal : '#fff'} stroke={done ? teal : line} stroke-width="1.5" />
          {done && <path d={`M121 ${86 + i * 46} l2 2 l4 -4`} stroke={navy} stroke-width="1.5" fill="none" />}
          <text x="136" y={83 + i * 46} font-size="8" font-weight="700" fill={navy}>{t}</text>
          <text x="136" y={95 + i * 46} font-size="6.5" fill="#5B6B7A">{a}</text>
        </g>
      ))}
      <rect x="112" y="206" width="96" height="20" rx="10" fill={teal} /><text x="160" y="219" text-anchor="middle" font-size="8" font-weight="700" fill={navy}>+ Add photo</text>
    </g>
  )}

  {kind === 'invoice' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Invoice #1042</text>
      <text x="112" y="72" font-size="7" fill="#5B6B7A">Mrs Patel · Kitchen refit</text>
      <line x1="112" y1="82" x2="208" y2="82" stroke={line} />
      <text x="112" y="96" font-size="7.5" fill={navy}>Labour</text><text x="208" y="96" text-anchor="end" font-size="7.5" fill={navy}>£640</text>
      <text x="112" y="110" font-size="7.5" fill={navy}>Materials</text><text x="208" y="110" text-anchor="end" font-size="7.5" fill={navy}>£385</text>
      <line x1="112" y1="120" x2="208" y2="120" stroke={line} />
      <text x="112" y="136" font-size="9" font-weight="800" fill={navy}>Total</text><text x="208" y="136" text-anchor="end" font-size="9" font-weight="800" fill={navy}>£1,025</text>
      <rect x="112" y="150" width="96" height="22" rx="11" fill={teal} /><text x="160" y="164" text-anchor="middle" font-size="8" font-weight="700" fill={navy}>Pay by card</text>
      <rect x="112" y="182" width="96" height="16" rx="8" fill={mint} /><text x="160" y="193" text-anchor="middle" font-size="6.5" font-weight="600" fill={navy}>Paid · thank you</text>
    </g>
  )}

  {kind === 'stock' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Stock</text>
      {[['Oat milk', 3, true], ['Coffee beans', 12, false], ['Cups 12oz', 140, false], ['Croissants', 2, true]].map(([n, c, low], i) => (
        <g>
          <rect x="112" y={66 + i * 32} width="96" height="26" rx="6" fill={low ? '#FFF1E6' : '#fff'} stroke={low ? '#F5B841' : line} />
          <text x="119" y={83 + i * 32} font-size="7.5" font-weight="600" fill={navy}>{n}</text>
          <text x="201" y={83 + i * 32} text-anchor="end" font-size="8" font-weight="800" fill={low ? '#C2410C' : navy}>{c}</text>
        </g>
      ))}
      <rect x="112" y="200" width="96" height="18" rx="9" fill={navy} /><text x="160" y="212" text-anchor="middle" font-size="7" font-weight="700" fill="#fff">2 items running low</text>
    </g>
  )}

  {kind === 'portal' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Hi Sarah</text>
      <text x="112" y="72" font-size="7" fill="#5B6B7A">Your 2026 tax return</text>
      <rect x="112" y="80" width="96" height="6" rx="3" fill={line} /><rect x="112" y="80" width="64" height="6" rx="3" fill={teal} />
      <text x="112" y="98" font-size="6.5" fill="#5B6B7A">Step 3 of 4 · Checking figures</text>
      {['Bank statements.pdf', 'Receipts.zip', 'P60.pdf'].map((f, i) => (
        <g>
          <rect x="112" y={108 + i * 26} width="96" height="20" rx="5" fill="#fff" stroke={line} />
          <rect x="117" y={112 + i * 26} width="10" height="12" rx="2" fill={mint} />
          <text x="132" y={121 + i * 26} font-size="7" fill={navy}>{f}</text>
        </g>
      ))}
      <rect x="112" y="190" width="96" height="22" rx="11" fill={teal} /><text x="160" y="204" text-anchor="middle" font-size="8" font-weight="700" fill={navy}>Upload a file</text>
    </g>
  )}

  {kind === 'rota' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>This week</text>
      {['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].map((d, i) => (
        <g>
          <text x="112" y={80 + i * 24} font-size="7.5" font-weight="600" fill="#5B6B7A">{d}</text>
          <rect x="134" y={70 + i * 24} width={i === 2 ? 0 : 74} height="16" rx="5" fill={i === 3 ? '#FFF1E6' : mint} />
          {i !== 2 && <text x="140" y={81 + i * 24} font-size="7" font-weight="600" fill={navy}>{i === 3 ? 'Swap asked' : '8:00 – 14:00'}</text>}
          {i === 2 && <text x="134" y={81 + i * 24} font-size="7" fill="#5B6B7A">Day off</text>}
        </g>
      ))}
      <rect x="112" y="196" width="96" height="22" rx="11" fill={navy} /><text x="160" y="210" text-anchor="middle" font-size="8" font-weight="700" fill="#fff">Approve swap</text>
    </g>
  )}

  {kind === 'checklist' && (
    <g font-family={ui}>
      <text x="112" y="58" font-size="10" font-weight="700" fill={navy}>Opening checks</text>
      {['Fridge under 5°C', 'Surfaces cleaned', 'Allergen board', 'Hot water OK'].map((c, i) => (
        <g>
          <rect x="112" y={68 + i * 28} width="96" height="22" rx="6" fill="#fff" stroke={line} />
          <rect x="118" y={74 + i * 28} width="10" height="10" rx="3" fill={i < 3 ? teal : '#fff'} stroke={i < 3 ? teal : line} />
          {i < 3 && <path d={`M120 ${79 + i * 28} l2 2 l4 -4`} stroke={navy} stroke-width="1.4" fill="none" />}
          <text x="134" y={82 + i * 28} font-size="7.5" fill={navy}>{c}</text>
        </g>
      ))}
      <text x="112" y="194" font-size="6.5" fill="#5B6B7A">Signed: Jo · 07:42</text>
      <rect x="112" y="202" width="96" height="20" rx="10" fill={teal} /><text x="160" y="215" text-anchor="middle" font-size="8" font-weight="700" fill={navy}>Save checks</text>
    </g>
  )}

  <!-- side bubbles for warmth -->
  <circle cx="52" cy="70" r="22" fill="#fff" />
  <path d="M42 70 l7 7 l13 -14" stroke={teal} stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="244" y="150" width="56" height="34" rx="10" fill="#fff" />
  <rect x="252" y="160" width="40" height="5" rx="2.5" fill={navy} opacity="0.6" />
  <rect x="252" y="170" width="28" height="5" rx="2.5" fill={navy} opacity="0.25" />
</svg>
